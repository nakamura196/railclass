 "label": {
  "ja": [
   "シカゴ「L」CTA 7000 系 運転台付きの車"
  ],
  "en": [
   "Chicago 'L' CTA 7000-series cab car"
  ]
 },
 "summary": {
  "ja": [
   "シカゴ交通局（CTA）の高架・地下鉄「L」の新しい電車 7000 系（CRRC 四方アメリカ、2021 年から）の運転台付きの車を、おもちゃの車台に載る大きさで起こした 3D モデル。ステンレスの車体に青い顔。寸法は写真から、遠近を補正して読んだ。"
  ],
  "en": [
   "3D model of a cab car of the Chicago Transit Authority's 7000-series 'L' cars (CRRC Sifang America, in service from 2021), sized to sit on a toy chassis. Stainless sides and a bright blue end cap. Dimensions were read from photographs, corrected for perspective."
  ]
 },
