 "label": {
  "ja": [
   "阿里山林業鉄路 DL-51（DL-45 形）"
  ],
  "en": [
   "Alishan Forest Railway DL-51 (DL-45 class)"
  ]
 },
 "summary": {
  "ja": [
   "台湾の阿里山林業鉄路の第 7 世代ディーゼル機関車（DL-45〜DL-51、日本車輌 2006〜07 年）を、おもちゃの車台に載る大きさで起こした 3D モデル。赤い車体に白い帯と V 字。寸法は写真から読んだ。"
  ],
  "en": [
   "3D model of the 7th-generation diesel locomotive (DL-45 to DL-51, Nippon Sharyo 2006-07) of Taiwan's Alishan Forest Railway, sized to sit on a toy chassis. Red with a white band and white V chevrons. Dimensions were read from photographs."
  ]
 },
 "metadata": [
  {
