 "label": {
  "ja": [
   "香港の路面電車（叮叮）74 号"
  ],
  "en": [
   "Hong Kong Tramways double-deck tram No. 74"
  ]
 },
 "summary": {
  "ja": [
   "香港島を走る 2 階建ての路面電車（叮叮）の、2011 年からの第 7 世代の車体を、おもちゃの車台に載る大きさで起こした 3D モデル。緑一色と、白い「笑顔」の黒いバンパー。寸法は写真から読んだ。"
  ],
  "en": [
   "3D model of the 7th-generation body (2011-) of the Hong Kong Tramways double-deck tram ('Ding Ding') on Hong Kong Island, sized to sit on a toy chassis. Plain tram green with the black bumper and its white smile. Dimensions were read from photographs."
  ]
 },
