    wdt:P17 wd:Q258 ;
    wdt:P176 wd:Q688893 ;
    wdt:P279 wd:Q483373 ;
    wdt:P729 "2010"^^xsd:gYear ;
    schema:subjectOf mdl:gautrain ;
    tb:handEntered wdt:P137,
        wdt:P17,
        wdt:P176,
        wdt:P279,
        wdt:P729 ;
