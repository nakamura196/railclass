cls:tb-gautrain a skos:Concept,
        tb:VehicleClass ;
    rdfs:label "Gautrain Electrostar"@en,
        "ハウトレインの電車（Electrostar）"@ja ;
    dcterms:source "Country, operator and opening date (2010-06-08) from Wikidata Q1476881 (Gautrain, the system); manufacturer and type (Bombardier Electrostar EMU) from the skytrain lab note docs/notes/gautrain.md (photos and en.wikipedia 'Gautrain', read 2026-10-11)."@en ;
    skos:inScheme cls: ;
    skos:prefLabel "Gautrain Electrostar"@en,
        "ハウトレインの電車（Electrostar）"@ja ;
