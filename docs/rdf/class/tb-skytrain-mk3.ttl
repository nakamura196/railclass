@prefix cls: <https://nakamura196.github.io/train-bodies/rdf/class/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix mdl: <https://nakamura196.github.io/train-bodies/rdf/model/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tb: <https://nakamura196.github.io/train-bodies/vocab#> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix wdt: <http://www.wikidata.org/prop/direct/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cls:tb-skytrain-mk3 a skos:Concept,
        tb:VehicleClass ;
    rdfs:label "SkyTrain Mark III"@en,
        "スカイトレイン Mark III"@ja ;
    dcterms:source "Country and operator from Wikidata Q876780 (SkyTrain (Vancouver)); manufacturer from English Wikipedia 'SkyTrain (Vancouver)' (rolling stock section, read 2026-10-09); service entry year from the train-bodies gallery text."@en ;
    skos:broadMatch wd:Q4940487 ;
    skos:broader cls:Q4940487 ;
    skos:inScheme <https://nakamura196.github.io/train-bodies/rdf/> ;
    skos:prefLabel "SkyTrain Mark III"@en,
        "スカイトレイン Mark III"@ja ;
    wdt:P137 wd:Q141170526 ;
    wdt:P17 wd:Q16 ;
    wdt:P176 wd:Q688893 ;
    wdt:P729 "2016"^^xsd:gYear ;
    tb:handEntered wdt:P137,
        wdt:P17,
        wdt:P176,
        wdt:P729 ;
    tb:has3DModel true ;
    schema:subjectOf mdl:mk3 .

