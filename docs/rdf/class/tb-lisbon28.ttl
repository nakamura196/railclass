cls:tb-lisbon28 a skos:Concept,
        tb:VehicleClass ;
    rdfs:label "Lisbon Remodelado tram (Carris 541-585)"@en,
        "リスボン市電の Remodelado（Carris 541〜585）"@ja ;
    dcterms:source "Country and operator (Carris) from Wikidata Q149629 (trams in Lisbon); type and the 1995-96 rebuild of the 1930s standard bodies (cars 541-585) from the skytrain lab note docs/notes/lisbon28.md."@en ;
    skos:inScheme cls: ;
    skos:prefLabel "Lisbon Remodelado tram (Carris 541-585)"@en,
        "リスボン市電の Remodelado（Carris 541〜585）"@ja ;
    wdt:P137 wd:Q1045108 ;
    wdt:P17 wd:Q45 ;
    wdt:P279 wd:Q3407658 ;
    wdt:P729 "1995"^^xsd:gYear ;
    schema:subjectOf mdl:lisbon28 ;
    tb:handEntered wdt:P137,
        wdt:P17,
        wdt:P279,
        wdt:P729 ;
    tb:has3DModel true ;
    tb:lineUse <https://w3id.org/railclass/tb-lisbon28#line1> ;
    tb:usedOn wd:Q149629 .

<https://w3id.org/railclass/tb-lisbon28#line1> a tb:LineUse ;
    dcterms:source <https://www.wikidata.org/wiki/Q149629> ;
    skos:note "the Lisbon tram system itself (the cars run on route 28); Wikidata has no item for the Remodelado trams"@en ;
