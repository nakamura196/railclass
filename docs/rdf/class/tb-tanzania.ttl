cls:tb-tanzania a skos:Concept,
        tb:VehicleClass ;
    rdfs:label "Tanzania SGR class E6800 electric locomotive"@en,
        "タンザニア SGR E6800 形電気機関車"@ja ;
    dcterms:source "Country and operator from Wikidata Q60744141 (Tanzania Standard Gauge Railway); manufacturer and type (Hyundai Rotem electric locomotive, class E6800) from Railvolution 'New locomotives for Tanzania'; passenger service from 2024-06-14 (Railway Journal, The Citizen), read 2026-10-12 via the skytrain lab note docs/notes/tanzania.md."@en ;
    skos:inScheme <https://nakamura196.github.io/train-bodies/rdf/> ;
    skos:prefLabel "Tanzania SGR class E6800 electric locomotive"@en,
        "タンザニア SGR E6800 形電気機関車"@ja ;
    wdt:P137 wd:Q2393276 ;
    wdt:P17 wd:Q924 ;
    wdt:P176 wd:Q152517 ;
    wdt:P279 wd:Q625151 ;
    wdt:P729 "2024"^^xsd:gYear ;
    tb:handEntered wdt:P137,
        wdt:P17,
        wdt:P176,
        wdt:P279,
        wdt:P729 ;
    tb:has3DModel true ;
    tb:lineUse <https://nakamura196.github.io/train-bodies/rdf/class/tb-tanzania#line1> ;
    tb:usedOn wd:Q60744141 ;
    schema:subjectOf mdl:tanzania .

<https://nakamura196.github.io/train-bodies/rdf/class/tb-tanzania#line1> a tb:LineUse ;
    dcterms:source <https://www.wikidata.org/wiki/Q60744141> ;
    skos:note "the Tanzania Standard Gauge Railway itself; Wikidata has no item for its Hyundai Rotem E6800 locomotives"@en ;
    tb:line wd:Q60744141 ;
    tb:sourceSection "Wikidata (the railway)" ;
    tb:useStatus "current" .

wd:Q60744141 rdfs:label "Tanzania Standard Gauge Railway"@en .

