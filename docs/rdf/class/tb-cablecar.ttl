@prefix cls: <https://w3id.org/railclass/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix mdl: <https://w3id.org/railclass/model/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tb: <https://w3id.org/railclass/vocab#> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix wdt: <http://www.wikidata.org/prop/direct/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cls:tb-cablecar a skos:Concept,
        tb:VehicleClass ;
    rdfs:label "San Francisco cable car (Powell Street single-ended type)"@en,
        "サンフランシスコのケーブルカー（パウエル線の片運転台の車）"@ja ;
    dcterms:source "Country, operator and type (cable car) from Wikidata Q374956 (San Francisco cable car system); the Powell Street single-ended car and its dimensions from streetcar.org via the skytrain lab note docs/notes/cablecar.md (2026-10-12)."@en ;
    skos:inScheme cls: ;
    skos:prefLabel "San Francisco cable car (Powell Street single-ended type)"@en,
        "サンフランシスコのケーブルカー（パウエル線の片運転台の車）"@ja ;
    wdt:P137 wd:Q1140138 ;
    wdt:P17 wd:Q30 ;
    wdt:P279 wd:Q5609555 ;
    schema:subjectOf mdl:cablecar ;
    tb:handEntered wdt:P137,
        wdt:P17,
        wdt:P279 ;
    tb:has3DModel true ;
    tb:lineUse <https://w3id.org/railclass/tb-cablecar#line1> ;
    tb:usedOn wd:Q374956 .

<https://w3id.org/railclass/tb-cablecar#line1> a tb:LineUse ;
    dcterms:source <https://www.wikidata.org/wiki/Q374956> ;
    skos:note "the San Francisco cable car system itself; Wikidata has no item for the cars"@en ;
    tb:line wd:Q374956 ;
    tb:sourceSection "Wikidata (the system)" ;
    tb:useStatus "current" .

wd:Q374956 rdfs:label "San Francisco cable car system"@en .

