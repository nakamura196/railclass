@prefix cls: <https://w3id.org/railclass/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tb: <https://w3id.org/railclass/vocab#> .

tb:LineUse a rdfs:Class ;
    rdfs:label "Line use"@en,
        "路線での運用"@ja ;
    rdfs:comment "One class on one line: tb:line, tb:useStatus, tb:usedUntil, dcterms:source."@en ;
    rdfs:isDefinedBy cls:vocab .

tb:VehicleClass a rdfs:Class ;
    rdfs:label "Vehicle class"@en,
        "形式"@ja ;
    rdfs:comment "A class (type) of railway vehicle or road vehicle; one record per class."@en ;
    rdfs:isDefinedBy cls:vocab .

cls: a skos:ConceptScheme ;
    rdfs:label "RailClass: vehicle classes"@en,
        "RailClass: 車両の形式"@ja ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> .

tb:handEntered a rdf:Property ;
    rdfs:label "hand-entered property"@en,
        "手入力の項目"@ja ;
    rdfs:comment "A property whose values on this class were entered by hand (see dcterms:source), not copied from Wikidata."@en ;
    rdfs:isDefinedBy cls:vocab .

tb:inferred a rdf:Property ;
    rdfs:label "inferred"@en,
        "推定"@ja ;
    rdfs:comment "True when the source names a service (e.g. a city pair) and the line was inferred from it."@en ;
    rdfs:isDefinedBy cls:vocab .

tb:line a rdf:Property ;
    rdfs:label "line"@en,
        "路線"@ja ;
    rdfs:comment "The line (a Wikidata item)."@en ;
    rdfs:isDefinedBy cls:vocab .

tb:lineUse a rdf:Property ;
    rdfs:label "line use"@en,
        "路線での運用"@ja ;
    rdfs:comment "How this class is (was) used on one line, with the source: a tb:LineUse."@en ;
    rdfs:isDefinedBy cls:vocab .

tb:operatingCountry a rdf:Property ;
    rdfs:label "operating country"@en,
        "運行国"@ja ;
    rdfs:comment "A country where this class runs or ran: the countries (Wikidata P17) of its operators (P137) and of the lines it runs on (P3438 on the line, and the hand-filled line table). Added because P17 on a class is sometimes only the country it was built in."@en ;
    rdfs:isDefinedBy cls:vocab .

tb:sourceSection a rdf:Property ;
    rdfs:label "source section"@en,
        "出典の節"@ja ;
    rdfs:comment "The section of the source (dcterms:source) that names the line."@en ;
    rdfs:isDefinedBy cls:vocab .

tb:useStatus a rdf:Property ;
    rdfs:label "status"@en,
        "運用の状態"@ja ;
    rdfs:comment "\"current\", \"historical\" or \"unknown\"."@en ;
    rdfs:isDefinedBy cls:vocab .

tb:usedOn a rdf:Property ;
    rdfs:label "used on line"@en,
        "走る路線"@ja ;
    rdfs:comment "A line (a Wikidata item) this class runs or ran on: the inverse direction of Wikidata P3438 (vehicle normally used), from the hand-filled table with sources, and from Wikidata P3438 statements (the source is the statement). See tb:lineUse for the status and the source."@en ;
    rdfs:isDefinedBy cls:vocab .

tb:usedUntil a rdf:Property ;
    rdfs:label "used until"@en,
        "運用の終わり"@ja ;
    rdfs:comment "The year the class stopped running on the line, when known (the last year the source mentions it, if no end is stated)."@en ;
    rdfs:isDefinedBy cls:vocab .

