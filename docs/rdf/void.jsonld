      "dcterms:creator": {
        "@id": "_:Nf597be4cc6ed4d56a4dd6b07d01d357f"
      },
      "dcterms:description": [
        {
          "@language": "en",
          "@value": "14,339 railway vehicle classes outside Japan, taken from Wikidata and linked to it (skos:exactMatch), with operator, manufacturer and other values as Wikidata IRIs, photos for 10,402 classes (Wikimedia Commons), the lines 933 classes run on, and 67 3D-printed vehicle bodies with their liveries. No SPARQL endpoint: every resource is a static file (Turtle and JSON-LD), and the whole dataset is in one dump file."
        },
        {
          "@language": "ja",
          "@value": "日本を除く世界の鉄道車両の形式 14,339 件。Wikidata から取り出し、skos:exactMatch で結んでいる。運行者・製造者などの値は Wikidata の IRI のまま持つ。写真 10,402 形式（Wikimedia Commons）、走る路線 933 形式、3D プリントで作った車体 67 件とその塗装を含む。SPARQL エンドポイントは無い。資源はすべて静的なファイル（Turtle と JSON-LD）で、全体は一括ファイル 1 つにまとめてある。"
        }
      ],
      "dcterms:isReferencedBy": {
        "@id": "https://github.com/nakamura196/railclass"
      },
      "dcterms:license": {
        "@id": "https://creativecommons.org/publicdomain/zero/1.0/"
      },
      "dcterms:modified": {
        "@type": "xsd:date",
        "@value": "2026-10-13"
      },
      "dcterms:publisher": {
        "@id": "_:Nf597be4cc6ed4d56a4dd6b07d01d357f"
      },
      "dcterms:rights": {
        "@language": "en",
        "@value": "Class data CC0. 3D models (schema:3DModel and their files) CC BY 4.0, stated on each model with schema:license. Photos: the licence of each Wikimedia Commons file."
      },
      "dcterms:source": {
        "@id": "http://www.wikidata.org/entity/Q2013"
      },
      "dcterms:title": [
        {
          "@language": "en",
          "@value": "RailClass: railway vehicle classes of the world"
        },
        {
          "@language": "ja",
          "@value": "RailClass: 世界の鉄道車両の形式"
        }
      ],
      "foaf:homepage": {
        "@id": "https://railclass.ldas.jp/"
      },
      "http://www.w3.org/2000/01/rdf-schema#comment": {
        "@language": "en",
        "@value": "There is no SPARQL endpoint. Load the dump (void:dataDump) into a triple store, or read single resources: each URI (a class <https://w3id.org/railclass/{id}>, a model <https://w3id.org/railclass/model/{id}>) is sent by w3id.org to its Turtle file, JSON-LD file or human page by the Accept header (text/turtle, application/ld+json, anything else)."
      },
