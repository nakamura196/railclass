<https://w3id.org/railclass/model/insurgente#livery> a tb:Livery ;
    rdfs:label "El Insurgente livery (white with a red nose and stripes in the Mexican flag colours)"@en,
        "エル・インスルヘンテの塗装（白地に赤い先頭と国旗の三色の帯）"@ja ;
    dcterms:source "Colours taken automatically from the face materials of skytrain/out/insurgente/ttm_insurgente.obj (area share of the painted surface, kept when >= 1.5%, white/grey/black when >= 20%; the colour samples keep them all; tools/extract_colors.py)"@en ;
    wdt:P462 wd:Q23444,
        wd:Q3133,
        wd:Q3142 ;
    tb:colorSample <https://w3id.org/railclass/model/insurgente#color1>,
        <https://w3id.org/railclass/model/insurgente#color2>,
        <https://w3id.org/railclass/model/insurgente#color3>,
        <https://w3id.org/railclass/model/insurgente#color4>,
        <https://w3id.org/railclass/model/insurgente#color5>,
        <https://w3id.org/railclass/model/insurgente#color6>,
        <https://w3id.org/railclass/model/insurgente#color7> ;
    tb:liveryOf wd:Q139837508 .

