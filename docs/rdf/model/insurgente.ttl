@prefix cls: <https://w3id.org/railclass/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix mdl: <https://w3id.org/railclass/model/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix tb: <https://w3id.org/railclass/vocab#> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix wdt: <http://www.wikidata.org/prop/direct/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

mdl:insurgente a schema:3DModel ;
    schema:about cls:tb-insurgente ;
    schema:contentUrl <https://railclass.ldas.jp/models/insurgente.glb> ;
    schema:depth [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 149.9 ] ;
    schema:description "メキシコ市とトルーカを結ぶ都市間鉄道のCAF製電車。赤い先頭と国旗の三色の帯。"@ja ;
    schema:encodingFormat "model/gltf-binary" ;
    schema:height [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 37.6 ] ;
    schema:license <https://creativecommons.org/licenses/by/4.0/> ;
    schema:name "エル・インスルヘンテ"@ja ;
    schema:subjectOf <https://railclass.ldas.jp/iiif/insurgente/manifest.json> ;
    schema:thumbnailUrl <https://railclass.ldas.jp/thumbs/insurgente.jpg> ;
    schema:url <https://railclass.ldas.jp/view.html#insurgente> ;
    schema:width [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 40.0 ] ;
    tb:galleryGroup "world" ;
    tb:livery <https://w3id.org/railclass/model/insurgente#livery> .

<https://w3id.org/railclass/model/insurgente#color1> a tb:ColorSample ;
    rdfs:label "white" ;
    wdt:P462 wd:Q23444 ;
    schema:color "#E8E9E6" ;
    tb:areaShare 0.6825 .

