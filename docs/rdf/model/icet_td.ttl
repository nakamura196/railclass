    tb:areaShare 0.0501 .

<https://w3id.org/railclass/model/icet_td#color3> a tb:ColorSample ;
    rdfs:label "skirt" ;
    wdt:P462 wd:Q42519 ;
    schema:color "#C2C7CA" ;
    tb:areaShare 0.0410 .

<https://w3id.org/railclass/model/icet_td#color4> a tb:ColorSample ;
    rdfs:label "red" ;
    wdt:P462 wd:Q3142 ;
    schema:color "#CC1014" ;
    tb:areaShare 0.0275 .

<https://w3id.org/railclass/model/icet_td#color5> a tb:ColorSample ;
    rdfs:label "grey" ;
    wdt:P462 wd:Q42519 ;
    schema:color "#5A6066" ;
