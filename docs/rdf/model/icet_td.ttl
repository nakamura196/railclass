@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix tb: <https://w3id.org/railclass/vocab#> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix wdt: <http://www.wikidata.org/prop/direct/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

mdl:icet_td a schema:3DModel ;
    schema:about cls:Q659660 ;
    schema:contentUrl <https://railclass-models.ldas.jp/files/railclass/icet_td.glb> ;
    schema:depth [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 149.9 ] ;
    schema:description "ディーゼル版の 605 形。外から見ると 411 と同じ。"@ja ;
    schema:encodingFormat "model/gltf-binary" ;
    schema:height [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 38.0 ] ;
    schema:license <http://rightsstatements.org/vocab/InC/1.0/> ;
    schema:name "ICE TD（DB）"@ja ;
    schema:subjectOf <https://railclass.ldas.jp/iiif/icet_td/manifest.json> ;
    schema:thumbnailUrl <https://railclass.ldas.jp/thumbs/icet_td.jpg> ;
    schema:url <https://railclass.ldas.jp/view.html#icet_td> ;
    schema:width [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 40.0 ] ;
    tb:galleryGroup "icet" ;
    tb:livery <https://w3id.org/railclass/model/icet_td#livery> .

<https://w3id.org/railclass/model/icet_td#color1> a tb:ColorSample ;
    rdfs:label "body" ;
    wdt:P462 wd:Q23444 ;
    schema:color "#ECEEEC" ;
    tb:areaShare 0.8663 .

