<https://w3id.org/railclass/model/icet_td#livery> a tb:Livery ;
    rdfs:label "Deutsche Bahn livery (red stripe)"@en,
        "DB の塗装（赤い帯）"@ja ;
    dcterms:source "Colours taken automatically from the face materials of skytrain/out/icet_td/icet_td.obj (area share of the painted surface, kept when >= 1.5%, white/grey/black when >= 20%; the colour samples keep them all; tools/extract_colors.py)"@en ;
    wdt:P462 wd:Q23444,
        wd:Q3142 ;
    tb:colorSample <https://w3id.org/railclass/model/icet_td#color1>,
        <https://w3id.org/railclass/model/icet_td#color2>,
        <https://w3id.org/railclass/model/icet_td#color3>,
        <https://w3id.org/railclass/model/icet_td#color4>,
        <https://w3id.org/railclass/model/icet_td#color5> ;
    tb:liveryOf wd:Q9322 .

