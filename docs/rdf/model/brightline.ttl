mdl:brightline a schema:3DModel ;
    schema:about cls:Q134533452 ;
    schema:contentUrl <https://railclass-models.ldas.jp/files/railclass/brightline.glb> ;
    schema:depth [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 148.9 ] ;
    schema:description "フロリダの民間特急の機関車。2022年からの黄色い塗装。"@ja ;
    schema:encodingFormat "model/gltf-binary" ;
    schema:height [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 37.5 ] ;
    schema:license <http://rightsstatements.org/vocab/InC/1.0/> ;
    schema:name "ブライトライン SCB-40"@ja ;
    schema:subjectOf <https://railclass.ldas.jp/iiif/brightline/manifest.json> ;
    schema:thumbnailUrl <https://railclass.ldas.jp/thumbs/brightline.jpg> ;
    schema:url <https://railclass.ldas.jp/view.html#brightline> ;
    schema:width [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 40.0 ] ;
    tb:galleryGroup "world" ;
    tb:livery <https://w3id.org/railclass/model/brightline#livery> .

