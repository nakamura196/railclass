mdl:yht a schema:3DModel ;
    schema:about cls:Q20988527 ;
    schema:contentUrl <https://railclass-models.ldas.jp/files/railclass/yht.glb> ;
    schema:depth [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 149.9 ] ;
    schema:description "トルコの高速電車。白にターコイズの帯の塗装。"@ja ;
    schema:encodingFormat "model/gltf-binary" ;
    schema:height [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 37.6 ] ;
    schema:license <http://rightsstatements.org/vocab/InC/1.0/> ;
    schema:name "YHT（ヴェラロ TR）"@ja ;
    schema:subjectOf <https://railclass.ldas.jp/iiif/yht/manifest.json> ;
    schema:thumbnailUrl <https://railclass.ldas.jp/thumbs/yht.jpg> ;
    schema:url <https://railclass.ldas.jp/view.html#yht> ;
    schema:width [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 40.0 ] ;
    tb:galleryGroup "world" ;
    tb:livery <https://w3id.org/railclass/model/yht#livery> .

