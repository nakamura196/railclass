@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

mdl:alishan a schema:3DModel ;
    schema:about cls:tb-alishan ;
    schema:contentUrl <https://railclass-models.ldas.jp/files/railclass/alishan.glb> ;
    schema:depth [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 150.2 ] ;
    schema:description "台湾の森林鉄道のディーゼル機関車。赤い車体に白い帯とV字。"@ja ;
    schema:encodingFormat "model/gltf-binary" ;
    schema:height [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 46.5 ] ;
    schema:license <http://rightsstatements.org/vocab/InC/1.0/> ;
    schema:name "阿里山林業鉄路 DL-45形"@ja ;
    schema:subjectOf <https://railclass.ldas.jp/iiif/alishan/manifest.json> ;
    schema:thumbnailUrl <https://railclass.ldas.jp/thumbs/alishan.jpg> ;
    schema:url <https://railclass.ldas.jp/view.html#alishan> ;
    schema:width [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 39.2 ] ;
    tb:galleryGroup "world" ;
    tb:livery <https://w3id.org/railclass/model/alishan#livery> .

