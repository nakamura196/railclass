@prefix cls: <https://w3id.org/railclass/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix mdl: <https://w3id.org/railclass/model/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix tb: <https://w3id.org/railclass/vocab#> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix wdt: <http://www.wikidata.org/prop/direct/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

mdl:hktram a schema:3DModel ;
    schema:about cls:tb-hktram ;
    schema:contentUrl <https://railclass-models.ldas.jp/files/railclass/hktram.glb> ;
    schema:depth [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 129.6 ] ;
    schema:description "香港島を走る2階建ての路面電車。2011年からの第7世代の車体、緑一色と「笑顔」のバンパー。"@ja ;
    schema:encodingFormat "model/gltf-binary" ;
    schema:height [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 46.4 ] ;
    schema:license <http://rightsstatements.org/vocab/InC/1.0/> ;
    schema:name "香港の路面電車（叮叮）"@ja ;
    schema:subjectOf <https://railclass.ldas.jp/iiif/hktram/manifest.json> ;
    schema:thumbnailUrl <https://railclass.ldas.jp/thumbs/hktram.jpg> ;
    schema:url <https://railclass.ldas.jp/view.html#hktram> ;
    schema:width [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 40.0 ] ;
    tb:galleryGroup "world" ;
    tb:livery <https://w3id.org/railclass/model/hktram#livery> .

<https://w3id.org/railclass/model/hktram#color1> a tb:ColorSample ;
    rdfs:label "green" ;
    wdt:P462 wd:Q3133 ;
    schema:color "#2F5E52" ;
    tb:areaShare 0.7727 .

<https://w3id.org/railclass/model/hktram#color2> a tb:ColorSample ;
    rdfs:label "roof" ;
    wdt:P462 wd:Q42519 ;
    schema:color "#45484C" ;
    tb:areaShare 0.1303 .

<https://w3id.org/railclass/model/hktram#color3> a tb:ColorSample ;
    rdfs:label "frame" ;
    wdt:P462 wd:Q3133 ;
    schema:color "#22443B" ;
    tb:areaShare 0.0505 .

<https://w3id.org/railclass/model/hktram#color4> a tb:ColorSample ;
    rdfs:label "black" ;
    wdt:P462 wd:Q23445 ;
    schema:color "#1C1C1E" ;
    tb:areaShare 0.0216 .

<https://w3id.org/railclass/model/hktram#color5> a tb:ColorSample ;
    rdfs:label "roofbox" ;
    wdt:P462 wd:Q42519 ;
    schema:color "#B9BDBE" ;
    tb:areaShare 0.0212 .

<https://w3id.org/railclass/model/hktram#livery> a tb:Livery ;
    rdfs:label "Hong Kong Tramways plain green livery (with the smiling bumper)"@en,
        "香港トラムの緑一色の塗装（笑顔のバンパー）"@ja ;
    dcterms:source "Colours taken automatically from the face materials of skytrain/out/hktram/hktramways_hktram.obj (area share of the painted surface, kept when >= 1.5%, white/grey/black when >= 20%; the colour samples keep them all; tools/extract_colors.py)"@en ;
    wdt:P462 wd:Q3133 ;
    tb:colorSample <https://w3id.org/railclass/model/hktram#color1>,
        <https://w3id.org/railclass/model/hktram#color2>,
        <https://w3id.org/railclass/model/hktram#color3>,
        <https://w3id.org/railclass/model/hktram#color4>,
        <https://w3id.org/railclass/model/hktram#color5> ;
    tb:liveryOf wd:Q15902782 .

