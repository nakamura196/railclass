@prefix cls: <https://w3id.org/railclass/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix mdl: <https://w3id.org/railclass/model/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix tb: <https://w3id.org/railclass/vocab#> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix wdt: <http://www.wikidata.org/prop/direct/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

mdl:wce a schema:3DModel ;
    schema:about cls:Q891775 ;
    schema:contentUrl <https://railclass-models.ldas.jp/files/railclass/wce.glb> ;
    schema:depth [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 150.0 ] ;
    schema:description "バンクーバーの通勤列車の2階建て制御客車。白と紫に金の線の塗装。"@ja ;
    schema:encodingFormat "model/gltf-binary" ;
    schema:height [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 46.0 ] ;
    schema:license <http://rightsstatements.org/vocab/InC/1.0/> ;
    schema:name "ウェストコースト・エクスプレス"@ja ;
    schema:subjectOf <https://railclass.ldas.jp/iiif/wce/manifest.json> ;
    schema:thumbnailUrl <https://railclass.ldas.jp/thumbs/wce.jpg> ;
    schema:url <https://railclass.ldas.jp/view.html#wce> ;
    schema:width [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 40.0 ] ;
    tb:galleryGroup "world" ;
    tb:livery <https://w3id.org/railclass/model/wce#livery> .

<https://w3id.org/railclass/model/wce#color1> a tb:ColorSample ;
    rdfs:label "body" ;
    wdt:P462 wd:Q23444 ;
    schema:color "#EAECEB" ;
    tb:areaShare 0.7541 .

<https://w3id.org/railclass/model/wce#color2> a tb:ColorSample ;
    rdfs:label "violet" ;
    wdt:P462 wd:Q1088 ;
    schema:color "#3D3B8C" ;
    tb:areaShare 0.1535 .

<https://w3id.org/railclass/model/wce#color3> a tb:ColorSample ;
    rdfs:label "gold" ;
    wdt:P462 wd:Q39338 ;
    schema:color "#F0AE1E" ;
    tb:areaShare 0.0492 .

<https://w3id.org/railclass/model/wce#color4> a tb:ColorSample ;
    rdfs:label "frame" ;
    wdt:P462 wd:Q23445 ;
    schema:color "#1C1E22" ;
    tb:areaShare 0.0353 .

<https://w3id.org/railclass/model/wce#livery> a tb:Livery ;
    rdfs:label "West Coast Express livery (white and violet with gold lines)"@en,
        "ウェストコースト・エクスプレスの塗装（白と紫に金の線）"@ja ;
    dcterms:source "Colours taken automatically from the face materials of skytrain/out/wce/translink_wce.obj (area share of the painted surface, kept when >= 1.5%, white/grey/black when >= 20%; the colour samples keep them all; tools/extract_colors.py)"@en ;
    wdt:P462 wd:Q1088,
        wd:Q23444,
        wd:Q39338 ;
    tb:colorSample <https://w3id.org/railclass/model/wce#color1>,
        <https://w3id.org/railclass/model/wce#color2>,
        <https://w3id.org/railclass/model/wce#color3>,
        <https://w3id.org/railclass/model/wce#color4> ;
    tb:liveryOf wd:Q1675085 .

