mdl:ic3 a schema:3DModel ;
    schema:about cls:Q706345 ;
    schema:contentUrl <https://railclass-models.ldas.jp/files/railclass/ic3.glb> ;
    schema:depth [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 149.5 ] ;
    schema:description "デンマークの気動車。顔の大きな黒いゴムの枠が目印。今の銀と紺の塗装。"@ja ;
    schema:encodingFormat "model/gltf-binary" ;
    schema:height [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 38.0 ] ;
    schema:license <http://rightsstatements.org/vocab/InC/1.0/> ;
    schema:name "IC3"@ja ;
    schema:subjectOf <https://railclass.ldas.jp/iiif/ic3/manifest.json> ;
    schema:thumbnailUrl <https://railclass.ldas.jp/thumbs/ic3.jpg> ;
    schema:url <https://railclass.ldas.jp/view.html#ic3> ;
    schema:width [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 40.0 ] ;
    tb:galleryGroup "world" ;
    tb:livery <https://w3id.org/railclass/model/ic3#livery> .

