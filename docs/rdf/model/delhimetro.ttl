mdl:delhimetro a schema:3DModel ;
    schema:about cls:tb-delhimetro ;
    schema:contentUrl <https://railclass-models.ldas.jp/files/railclass/delhimetro.glb> ;
    schema:depth [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 149.9 ] ;
    schema:description "インドで最初の無人運転の地下鉄。現代ロテム製、黒い鼻とマゼンタの帯。"@ja ;
    schema:encodingFormat "model/gltf-binary" ;
    schema:height [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 37.6 ] ;
    schema:license <http://rightsstatements.org/vocab/InC/1.0/> ;
    schema:name "デリーメトロ マゼンタ線"@ja ;
    schema:subjectOf <https://railclass.ldas.jp/iiif/delhimetro/manifest.json> ;
    schema:thumbnailUrl <https://railclass.ldas.jp/thumbs/delhimetro.jpg> ;
    schema:url <https://railclass.ldas.jp/view.html#delhimetro> ;
    schema:width [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 40.0 ] ;
    tb:galleryGroup "world" ;
    tb:livery <https://w3id.org/railclass/model/delhimetro#livery> .

