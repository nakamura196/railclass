<https://w3id.org/railclass/model/glacier#livery> a tb:Livery ;
    rdfs:label "Glacier Express livery (red ends with white Swiss-cross pieces)"@en,
        "氷河特急の塗装（赤い端に白い十字のかけら）"@ja ;
    dcterms:source "Colours taken automatically from the face materials of skytrain/out/glacier/gex_glacier.obj (area share of the painted surface, kept when >= 1.5%, white/grey/black when >= 20%; the colour samples keep them all; tools/extract_colors.py)"@en ;
    wdt:P462 wd:Q1088,
        wd:Q3142 ;
    tb:colorSample <https://w3id.org/railclass/model/glacier#color1>,
