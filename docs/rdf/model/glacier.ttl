@prefix wd: <http://www.wikidata.org/entity/> .
@prefix wdt: <http://www.wikidata.org/prop/direct/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

mdl:glacier a schema:3DModel ;
    schema:about cls:Q2805042 ;
    schema:contentUrl <https://railclass.ldas.jp/models/glacier.glb> ;
    schema:depth [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 150.0 ] ;
    schema:description "スイスの観光列車の2等パノラマ客車（Stadler製 Bp）。赤い端に白いかけら、屋根まで回り込む窓。"@ja ;
    schema:encodingFormat "model/gltf-binary" ;
    schema:height [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 40.0 ] ;
    schema:license <https://creativecommons.org/licenses/by/4.0/> ;
    schema:name "氷河特急 パノラマ客車"@ja ;
    schema:subjectOf <https://railclass.ldas.jp/iiif/glacier/manifest.json> ;
    schema:thumbnailUrl <https://railclass.ldas.jp/thumbs/glacier.jpg> ;
    schema:url <https://railclass.ldas.jp/view.html#glacier> ;
    schema:width [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 40.0 ] ;
    tb:galleryGroup "world" ;
    tb:livery <https://w3id.org/railclass/model/glacier#livery> .

<https://w3id.org/railclass/model/glacier#color1> a tb:ColorSample ;
