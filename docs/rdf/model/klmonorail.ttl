<https://w3id.org/railclass/model/klmonorail#livery> a tb:Livery ;
    rdfs:label "Rapid KL monorail livery (red and white)"@en,
        "Rapid KL のモノレールの塗装（赤と白）"@ja ;
    dcterms:source "Colours taken automatically from the face materials of skytrain/out/klmonorail/rapidkl_klmonorail.obj (area share of the painted surface, kept when >= 1.5%, white/grey/black when >= 20%; the colour samples keep them all; tools/extract_colors.py)"@en ;
