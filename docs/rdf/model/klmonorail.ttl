@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

mdl:klmonorail a schema:3DModel ;
    schema:about cls:Q19896241 ;
    schema:contentUrl <https://railclass-models.ldas.jp/files/railclass/klmonorail.glb> ;
    schema:depth [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 149.9 ] ;
    schema:description "クアラルンプールの跨座式モノレール。Rapid KL の赤と白の塗装、4両編成の端の車。"@ja ;
    schema:encodingFormat "model/gltf-binary" ;
    schema:height [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 39.8 ] ;
    schema:license <http://rightsstatements.org/vocab/InC/1.0/> ;
    schema:name "KL モノレール（スコミ SUTRA）"@ja ;
    schema:subjectOf <https://railclass.ldas.jp/iiif/klmonorail/manifest.json> ;
    schema:thumbnailUrl <https://railclass.ldas.jp/thumbs/klmonorail.jpg> ;
    schema:url <https://railclass.ldas.jp/view.html#klmonorail> ;
    schema:width [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 40.0 ] ;
    tb:galleryGroup "world" ;
    tb:livery <https://w3id.org/railclass/model/klmonorail#livery> .

