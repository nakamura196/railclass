@prefix wd: <http://www.wikidata.org/entity/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

mdl:bus49_front a schema:3DModel ;
    tb:galleryGroup "bus" ;
    tb:livery <https://nakamura196.github.io/train-bodies/rdf/model/bus49_front#livery> ;
    tb:part "front half of the articulated bus"@en,
        "連節バスの前半分"@ja ;
    schema:about cls:Q137921671 ;
    schema:contentUrl <https://nakamura196.github.io/train-bodies/models/bus49_front.glb> ;
    schema:depth [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 145.1 ] ;
    schema:description "TransLink の連節バス XD60 の前半分。"@ja ;
    schema:encodingFormat "model/gltf-binary" ;
    schema:height [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 46.0 ] ;
    schema:name "49番バス（前）"@ja ;
    schema:subjectOf <https://nakamura196.github.io/train-bodies/iiif/bus49_front/manifest.json> ;
    schema:thumbnailUrl <https://nakamura196.github.io/train-bodies/thumbs/bus49_front.jpg> ;
    schema:url <https://nakamura196.github.io/train-bodies/#bus49_front> ;
    schema:width [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 40.0 ] .

<https://nakamura196.github.io/train-bodies/rdf/model/bus49_front#livery> a tb:Livery ;
    rdfs:label "TransLink livery"@en,
        "TransLink の塗装"@ja ;
    tb:liveryOf wd:Q1142140 .

