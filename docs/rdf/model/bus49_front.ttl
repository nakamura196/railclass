mdl:bus49_front a schema:3DModel ;
    schema:about cls:Q137921671 ;
    schema:contentUrl <https://railclass.ldas.jp/models/bus49_front.glb> ;
    schema:depth [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 145.1 ] ;
    schema:description "TransLink の連節バス XD60 の前半分。"@ja ;
    schema:encodingFormat "model/gltf-binary" ;
    schema:height [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 46.0 ] ;
    schema:license <https://creativecommons.org/licenses/by/4.0/> ;
    schema:name "49番バス（前）"@ja ;
    schema:subjectOf <https://railclass.ldas.jp/iiif/bus49_front/manifest.json> ;
    schema:thumbnailUrl <https://railclass.ldas.jp/thumbs/bus49_front.jpg> ;
    schema:url <https://railclass.ldas.jp/view.html#bus49_front> ;
    schema:width [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 40.0 ] ;
    tb:galleryGroup "bus" ;
    tb:livery <https://w3id.org/railclass/model/bus49_front#livery> ;
    tb:part "front half of the articulated bus"@en,
        "連節バスの前半分"@ja .

