@prefix cls: <https://w3id.org/railclass/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix mdl: <https://w3id.org/railclass/model/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix tb: <https://w3id.org/railclass/vocab#> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix wdt: <http://www.wikidata.org/prop/direct/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

mdl:bart a schema:3DModel ;
    schema:about cls:Q134207119 ;
    schema:contentUrl <https://railclass-models.ldas.jp/files/railclass/bart.glb> ;
    schema:depth [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 149.5 ] ;
    schema:description "サンフランシスコ湾岸の BART の新型車（D 車）。2018年から。白い顔と青い帯。"@ja ;
    schema:encodingFormat "model/gltf-binary" ;
    schema:height [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 38.0 ] ;
    schema:license <http://rightsstatements.org/vocab/InC/1.0/> ;
    schema:name "BART フリート・オブ・ザ・フューチャー"@ja ;
    schema:subjectOf <https://railclass.ldas.jp/iiif/bart/manifest.json> ;
    schema:thumbnailUrl <https://railclass.ldas.jp/thumbs/bart.jpg> ;
    schema:url <https://railclass.ldas.jp/view.html#bart> ;
    schema:width [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 40.0 ] ;
    tb:galleryGroup "world" ;
    tb:livery <https://w3id.org/railclass/model/bart#livery> .

