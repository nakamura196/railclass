<https://w3id.org/railclass/model/bart#livery> a tb:Livery ;
    rdfs:label "BART Fleet of the Future livery (white front cap, blue band on aluminium)"@en,
        "BART の新型車の塗装（白い顔、アルミに青い帯）"@ja ;
    dcterms:source "Colours taken automatically from the face materials of skytrain/out/bart/bart_bart.obj (area share of the painted surface, kept when >= 1.5%, white/grey/black when >= 20%; the colour samples keep them all; tools/extract_colors.py)"@en ;
    wdt:P462 wd:Q1088,
        wd:Q23444,
        wd:Q42519 ;
    tb:colorSample <https://w3id.org/railclass/model/bart#color1>,
