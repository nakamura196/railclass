@prefix cls: <https://nakamura196.github.io/train-bodies/rdf/class/> .
@prefix mdl: <https://nakamura196.github.io/train-bodies/rdf/model/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix tb: <https://nakamura196.github.io/train-bodies/vocab#> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

mdl:mk1 a schema:3DModel ;
    tb:galleryGroup "skytrain" ;
    tb:livery <https://nakamura196.github.io/train-bodies/rdf/model/mk1#livery> ;
    schema:about cls:tb-skytrain-mk1 ;
    schema:contentUrl <https://nakamura196.github.io/train-bodies/models/mk1.glb> ;
    schema:depth [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 130.0 ] ;
    schema:description "1985年から走る、角ばった短い車体。今の TransLink 塗装。"@ja ;
    schema:encodingFormat "model/gltf-binary" ;
    schema:height [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 38.0 ] ;
    schema:name "Mark I"@ja ;
    schema:subjectOf <https://nakamura196.github.io/train-bodies/iiif/mk1/manifest.json> ;
    schema:thumbnailUrl <https://nakamura196.github.io/train-bodies/thumbs/mk1.jpg> ;
    schema:url <https://nakamura196.github.io/train-bodies/#mk1> ;
    schema:width [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 40.0 ] .

<https://nakamura196.github.io/train-bodies/rdf/model/mk1#livery> a tb:Livery ;
    rdfs:label "TransLink livery"@en,
        "TransLink の塗装"@ja ;
    tb:liveryOf wd:Q1142140 .

