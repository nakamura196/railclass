@prefix wdt: <http://www.wikidata.org/prop/direct/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

mdl:italo a schema:3DModel ;
    schema:about cls:Q432478 ;
    schema:contentUrl <https://railclass.ldas.jp/models/italo.glb> ;
    schema:depth [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 151.0 ] ;
    schema:description "イタリアの民間高速列車。2026年からの赤と金の新塗装。"@ja ;
    schema:encodingFormat "model/gltf-binary" ;
    schema:height [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 38.0 ] ;
    schema:license <https://creativecommons.org/licenses/by/4.0/> ;
    schema:name "イタロ AGV 575"@ja ;
    schema:subjectOf <https://railclass.ldas.jp/iiif/italo/manifest.json> ;
    schema:thumbnailUrl <https://railclass.ldas.jp/thumbs/italo.jpg> ;
    schema:url <https://railclass.ldas.jp/view.html#italo> ;
    schema:width [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 40.0 ] ;
    tb:galleryGroup "world" ;
    tb:livery <https://w3id.org/railclass/model/italo#livery> .

