    rdfs:label "Italo livery from 2026 (red and gold)"@en,
        "イタロの 2026 年からの塗装（赤と金）"@ja ;
    dcterms:source "Colours taken automatically from the face materials of skytrain/out/italo/ntv_italo.obj (area share of the painted surface, kept when >= 1.5%, white/grey/black when >= 20%; the colour samples keep them all; tools/extract_colors.py)"@en ;
