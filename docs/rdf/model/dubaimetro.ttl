<https://w3id.org/railclass/model/dubaimetro#livery> a tb:Livery ;
    rdfs:label "Dubai Metro livery (silver and light blue)"@en,
        "ドバイメトロの塗装（銀と水色）"@ja ;
    dcterms:source "Colours taken automatically from the face materials of skytrain/out/dubaimetro/rta_dubaimetro.obj (area share of the painted surface, kept when >= 1.5%, white/grey/black when >= 20%; the colour samples keep them all; tools/extract_colors.py)"@en ;
    wdt:P462 wd:Q1088,
        wd:Q42519 ;
    tb:colorSample <https://w3id.org/railclass/model/dubaimetro#color1>,
        <https://w3id.org/railclass/model/dubaimetro#color2>,
        <https://w3id.org/railclass/model/dubaimetro#color3>,
        <https://w3id.org/railclass/model/dubaimetro#color4>,
        <https://w3id.org/railclass/model/dubaimetro#color5> ;
    tb:liveryOf wd:Q22101985 .

