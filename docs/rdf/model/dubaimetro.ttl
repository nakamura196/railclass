@prefix cls: <https://w3id.org/railclass/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix mdl: <https://w3id.org/railclass/model/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix tb: <https://w3id.org/railclass/vocab#> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix wdt: <http://www.wikidata.org/prop/direct/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

mdl:dubaimetro a schema:3DModel ;
    schema:about cls:tb-dubaimetro ;
    schema:contentUrl <https://railclass.ldas.jp/models/dubaimetro.glb> ;
    schema:depth [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 149.9 ] ;
    schema:description "ドバイの無人運転の地下鉄・高架鉄道。近畿車輛製の、銀と水色の標準塗装。"@ja ;
    schema:encodingFormat "model/gltf-binary" ;
    schema:height [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 38.0 ] ;
    schema:license <https://creativecommons.org/licenses/by/4.0/> ;
    schema:name "ドバイメトロ"@ja ;
    schema:subjectOf <https://railclass.ldas.jp/iiif/dubaimetro/manifest.json> ;
    schema:thumbnailUrl <https://railclass.ldas.jp/thumbs/dubaimetro.jpg> ;
    schema:url <https://railclass.ldas.jp/view.html#dubaimetro> ;
    schema:width [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 40.0 ] ;
    tb:galleryGroup "world" ;
    tb:livery <https://w3id.org/railclass/model/dubaimetro#livery> .

<https://w3id.org/railclass/model/dubaimetro#color1> a tb:ColorSample ;
    rdfs:label "body" ;
    wdt:P462 wd:Q42519 ;
    schema:color "#C9CED3" ;
    tb:areaShare 0.7779 .

