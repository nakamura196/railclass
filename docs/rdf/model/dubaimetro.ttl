<https://w3id.org/railclass/model/dubaimetro#color3> a tb:ColorSample ;
    rdfs:label "mask" ;
    wdt:P462 wd:Q23445 ;
    schema:color "#1B222A" ;
    tb:areaShare 0.0464 .

<https://w3id.org/railclass/model/dubaimetro#color4> a tb:ColorSample ;
    rdfs:label "screen" ;
    wdt:P462 wd:Q1088 ;
    schema:color "#344658" ;
    tb:areaShare 0.0193 .

<https://w3id.org/railclass/model/dubaimetro#color5> a tb:ColorSample ;
    rdfs:label "grey" ;
    wdt:P462 wd:Q42519 ;
    schema:color "#5A6066" ;
