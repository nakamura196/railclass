@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

mdl:darjeeling a schema:3DModel ;
    schema:about cls:Q18349836 ;
    schema:contentUrl <https://railclass.ldas.jp/models/darjeeling.glb> ;
    schema:depth [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 150.0 ] ;
    schema:description "世界遺産「トイ・トレイン」の小さな蒸気機関車。青に白線の塗装（782号機）。"@ja ;
    schema:encodingFormat "model/gltf-binary" ;
    schema:height [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 46.3 ] ;
    schema:license <https://creativecommons.org/licenses/by/4.0/> ;
    schema:name "ダージリン・ヒマラヤ鉄道 B形"@ja ;
    schema:subjectOf <https://railclass.ldas.jp/iiif/darjeeling/manifest.json> ;
    schema:thumbnailUrl <https://railclass.ldas.jp/thumbs/darjeeling.jpg> ;
    schema:url <https://railclass.ldas.jp/view.html#darjeeling> ;
    schema:width [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 40.0 ] ;
    tb:galleryGroup "world" ;
    tb:livery <https://w3id.org/railclass/model/darjeeling#livery> .

