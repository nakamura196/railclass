@prefix cls: <https://w3id.org/railclass/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix mdl: <https://w3id.org/railclass/model/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix tb: <https://w3id.org/railclass/vocab#> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix wdt: <http://www.wikidata.org/prop/direct/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

mdl:vistadome a schema:3DModel ;
    schema:about cls:tb-vistadome ;
    schema:contentUrl <https://railclass.ldas.jp/models/vistadome.glb> ;
    schema:depth [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 150.0 ] ;
    schema:description "マチュピチュへ向かう観光列車の、屋根に天窓が並ぶ気動車。青に黄の線の塗装（2023年の写真まで確認）。"@ja ;
    schema:encodingFormat "model/gltf-binary" ;
    schema:height [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 39.0 ] ;
    schema:license <https://creativecommons.org/licenses/by/4.0/> ;
    schema:name "ペルーレイル ビスタドーム"@ja ;
    schema:subjectOf <https://railclass.ldas.jp/iiif/vistadome/manifest.json> ;
    schema:thumbnailUrl <https://railclass.ldas.jp/thumbs/vistadome.jpg> ;
    schema:url <https://railclass.ldas.jp/view.html#vistadome> ;
    schema:width [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 40.0 ] ;
    tb:galleryGroup "world" ;
    tb:livery <https://w3id.org/railclass/model/vistadome#livery> .

<https://w3id.org/railclass/model/vistadome#color1> a tb:ColorSample ;
    rdfs:label "blue" ;
    wdt:P462 wd:Q1088 ;
    schema:color "#264EBC" ;
    tb:areaShare 0.6794 .

<https://w3id.org/railclass/model/vistadome#color2> a tb:ColorSample ;
    rdfs:label "silver" ;
    wdt:P462 wd:Q42519 ;
    schema:color "#C4C8CC" ;
    tb:areaShare 0.1631 .

<https://w3id.org/railclass/model/vistadome#color3> a tb:ColorSample ;
    rdfs:label "yellow" ;
    wdt:P462 wd:Q943 ;
    schema:color "#F2C21A" ;
    tb:areaShare 0.0548 .

<https://w3id.org/railclass/model/vistadome#color4> a tb:ColorSample ;
    rdfs:label "skylight" ;
    wdt:P462 wd:Q1088 ;
    schema:color "#7E93A3" ;
    tb:areaShare 0.0397 .

<https://w3id.org/railclass/model/vistadome#color5> a tb:ColorSample ;
    rdfs:label "frame" ;
    wdt:P462 wd:Q42519 ;
    schema:color "#9CA2A8" ;
    tb:areaShare 0.0395 .

<https://w3id.org/railclass/model/vistadome#color6> a tb:ColorSample ;
    rdfs:label "screen" ;
    wdt:P462 wd:Q1088 ;
    schema:color "#5E7080" ;
    tb:areaShare 0.0142 .

<https://w3id.org/railclass/model/vistadome#livery> a tb:Livery ;
    rdfs:label "PeruRail livery (blue with yellow stripes, silver roof; seen in photos up to 2023)"@en,
        "ペルーレイルの塗装（青に黄の線、銀の屋根。2023年の写真まで確認）"@ja ;
    dcterms:source "Colours taken automatically from the face materials of skytrain/out/vistadome/perurail_vistadome.obj (area share of the painted surface, kept when >= 1.5%, white/grey/black when >= 20%; the colour samples keep them all; tools/extract_colors.py)"@en ;
    wdt:P462 wd:Q1088,
        wd:Q42519,
        wd:Q943 ;
    tb:colorSample <https://w3id.org/railclass/model/vistadome#color1>,
        <https://w3id.org/railclass/model/vistadome#color2>,
        <https://w3id.org/railclass/model/vistadome#color3>,
        <https://w3id.org/railclass/model/vistadome#color4>,
        <https://w3id.org/railclass/model/vistadome#color5>,
        <https://w3id.org/railclass/model/vistadome#color6> ;
    tb:liveryOf wd:Q1407952 .

