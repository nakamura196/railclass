    rdfs:label "Rhaetian Railway livery"@en,
        "レーティッシュ鉄道の塗装"@ja ;
    dcterms:source "Colours taken automatically from the face materials of skytrain/out/allegra/rhb_allegra.obj (area share of the painted surface, kept when >= 1.5%, white/grey/black when >= 20%; the colour samples keep them all; tools/extract_colors.py)"@en ;
