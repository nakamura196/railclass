@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix mdl: <https://w3id.org/railclass/model/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix tb: <https://w3id.org/railclass/vocab#> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix wdt: <http://www.wikidata.org/prop/direct/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

mdl:allegra a schema:3DModel ;
    schema:about cls:Q671805 ;
    schema:contentUrl <https://railclass-models.ldas.jp/files/railclass/allegra.glb> ;
    schema:depth [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 149.9 ] ;
    schema:description "スイスの山岳路線を走る 3 車体連接の電車。2010年から。"@ja ;
    schema:encodingFormat "model/gltf-binary" ;
    schema:height [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 37.7 ] ;
    schema:license <http://rightsstatements.org/vocab/InC/1.0/> ;
    schema:name "Allegra（レーティッシュ鉄道）"@ja ;
    schema:subjectOf <https://railclass.ldas.jp/iiif/allegra/manifest.json> ;
    schema:thumbnailUrl <https://railclass.ldas.jp/thumbs/allegra.jpg> ;
    schema:url <https://railclass.ldas.jp/view.html#allegra> ;
    schema:width [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 40.0 ] ;
    tb:galleryGroup "world" ;
    tb:livery <https://w3id.org/railclass/model/allegra#livery> .

