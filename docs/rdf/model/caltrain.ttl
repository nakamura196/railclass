@prefix wdt: <http://www.wikidata.org/prop/direct/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

mdl:caltrain a schema:3DModel ;
    schema:about cls:Q130240621 ;
    schema:contentUrl <https://railclass.ldas.jp/models/caltrain.glb> ;
    schema:depth [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 149.9 ] ;
    schema:description "サンフランシスコ半島の通勤鉄道の2階建て電車。2024年の電化で入った赤と白の塗装。"@ja ;
    schema:encodingFormat "model/gltf-binary" ;
    schema:height [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 45.6 ] ;
    schema:license <https://creativecommons.org/licenses/by/4.0/> ;
    schema:name "カルトレイン KISS"@ja ;
    schema:subjectOf <https://railclass.ldas.jp/iiif/caltrain/manifest.json> ;
    schema:thumbnailUrl <https://railclass.ldas.jp/thumbs/caltrain.jpg> ;
    schema:url <https://railclass.ldas.jp/view.html#caltrain> ;
    schema:width [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 40.0 ] ;
    tb:galleryGroup "world" ;
    tb:livery <https://w3id.org/railclass/model/caltrain#livery> .

