<https://w3id.org/railclass/model/cablecar#livery> a tb:Livery ;
    rdfs:label "Muni cable car livery (maroon, cream and light blue)"@en,
        "Muni のケーブルカーの塗装（栗色・クリーム・水色）"@ja ;
    dcterms:source "Colours taken automatically from the face materials of skytrain/out/cablecar/muni_cablecar.obj (area share of the painted surface, kept when >= 1.5%, white/grey/black when >= 20%; the colour samples keep them all; tools/extract_colors.py)"@en ;
    wdt:P462 wd:Q1088,
        wd:Q39338,
        wd:Q47071 ;
    tb:colorSample <https://w3id.org/railclass/model/cablecar#color1>,
        <https://w3id.org/railclass/model/cablecar#color10>,
