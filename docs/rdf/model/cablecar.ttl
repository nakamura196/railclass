mdl:cablecar a schema:3DModel ;
    tb:galleryGroup "world" ;
    tb:livery <https://nakamura196.github.io/train-bodies/rdf/model/cablecar#livery> ;
    schema:about cls:tb-cablecar ;
    schema:contentUrl <https://nakamura196.github.io/train-bodies/models/cablecar.glb> ;
    schema:depth [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 150.0 ] ;
    schema:description "パウエル線の片運転台の車（1号車）。栗色・クリーム・水色のMuni塗装。"@ja ;
    schema:encodingFormat "model/gltf-binary" ;
    schema:height [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 44.8 ] ;
    schema:license <https://creativecommons.org/licenses/by/4.0/> ;
    schema:name "サンフランシスコのケーブルカー"@ja ;
    schema:subjectOf <https://nakamura196.github.io/train-bodies/iiif/cablecar/manifest.json> ;
    schema:thumbnailUrl <https://nakamura196.github.io/train-bodies/thumbs/cablecar.jpg> ;
    schema:url <https://nakamura196.github.io/train-bodies/view.html#cablecar> ;
    schema:width [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 40.0 ] .

