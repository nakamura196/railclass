@prefix cls: <https://w3id.org/railclass/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix mdl: <https://w3id.org/railclass/model/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix tb: <https://w3id.org/railclass/vocab#> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix wdt: <http://www.wikidata.org/prop/direct/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

mdl:cablecar a schema:3DModel ;
    schema:about cls:tb-cablecar ;
    schema:contentUrl <https://railclass-models.ldas.jp/files/railclass/cablecar.glb> ;
    schema:depth [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 150.0 ] ;
    schema:description "パウエル線の片運転台の車（1号車）。栗色・クリーム・水色のMuni塗装。"@ja ;
    schema:encodingFormat "model/gltf-binary" ;
    schema:height [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 44.8 ] ;
    schema:license <http://rightsstatements.org/vocab/InC/1.0/> ;
    schema:name "サンフランシスコのケーブルカー"@ja ;
    schema:subjectOf <https://railclass.ldas.jp/iiif/cablecar/manifest.json> ;
    schema:thumbnailUrl <https://railclass.ldas.jp/thumbs/cablecar.jpg> ;
    schema:url <https://railclass.ldas.jp/view.html#cablecar> ;
    schema:width [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 40.0 ] ;
    tb:galleryGroup "world" ;
    tb:livery <https://w3id.org/railclass/model/cablecar#livery> .

<https://w3id.org/railclass/model/cablecar#color1> a tb:ColorSample ;
    rdfs:label "cream" ;
    wdt:P462 wd:Q39338 ;
    schema:color "#ECE3C8" ;
    tb:areaShare 0.6158 .

