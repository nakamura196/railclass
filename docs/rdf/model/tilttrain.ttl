mdl:tilttrain a schema:3DModel ;
    schema:about cls:Q23641827 ;
    schema:contentUrl <https://railclass.ldas.jp/models/tilttrain.glb> ;
    schema:depth [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 150.0 ] ;
    schema:description "オーストラリア・クイーンズランド州の振り子式電車。2015〜17年の更新後の、黄色の先頭部とステンレスの塗装。"@ja ;
    schema:encodingFormat "model/gltf-binary" ;
    schema:height [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 38.0 ] ;
    schema:license <https://creativecommons.org/licenses/by/4.0/> ;
    schema:name "電気式ティルト・トレイン"@ja ;
    schema:subjectOf <https://railclass.ldas.jp/iiif/tilttrain/manifest.json> ;
    schema:thumbnailUrl <https://railclass.ldas.jp/thumbs/tilttrain.jpg> ;
    schema:url <https://railclass.ldas.jp/view.html#tilttrain> ;
    schema:width [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 40.0 ] ;
    tb:galleryGroup "world" ;
    tb:livery <https://w3id.org/railclass/model/tilttrain#livery> .

