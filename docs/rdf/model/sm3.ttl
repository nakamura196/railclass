mdl:sm3 a schema:3DModel ;
    schema:about cls:Q935909 ;
    schema:contentUrl <https://railclass.ldas.jp/models/sm3.glb> ;
    schema:depth [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 150.0 ] ;
    schema:description "フィンランドの振り子式電車。白に緑の帯、森の絵と前に突き出た連結器の箱。"@ja ;
    schema:encodingFormat "model/gltf-binary" ;
    schema:height [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 38.0 ] ;
    schema:license <https://creativecommons.org/licenses/by/4.0/> ;
    schema:name "VR Sm3 ペンドリーノ"@ja ;
    schema:subjectOf <https://railclass.ldas.jp/iiif/sm3/manifest.json> ;
    schema:thumbnailUrl <https://railclass.ldas.jp/thumbs/sm3.jpg> ;
    schema:url <https://railclass.ldas.jp/view.html#sm3> ;
    schema:width [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 40.0 ] ;
    tb:galleryGroup "world" ;
    tb:livery <https://w3id.org/railclass/model/sm3#livery> .

