mdl:bus49_rear a schema:3DModel ;
    schema:about cls:Q137921671 ;
    schema:contentUrl <https://railclass-models.ldas.jp/files/railclass/bus49_rear.glb> ;
    schema:depth [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 143.5 ] ;
    schema:description "同じバスの後ろ半分。2 台をつないで走らせる。"@ja ;
    schema:encodingFormat "model/gltf-binary" ;
    schema:height [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 46.0 ] ;
    schema:license <http://rightsstatements.org/vocab/InC/1.0/> ;
    schema:name "49番バス（後ろ）"@ja ;
    schema:subjectOf <https://railclass.ldas.jp/iiif/bus49_rear/manifest.json> ;
    schema:thumbnailUrl <https://railclass.ldas.jp/thumbs/bus49_rear.jpg> ;
    schema:url <https://railclass.ldas.jp/view.html#bus49_rear> ;
    schema:width [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 40.0 ] ;
    tb:galleryGroup "bus" ;
    tb:livery <https://w3id.org/railclass/model/bus49_rear#livery> ;
    tb:part "rear half of the articulated bus"@en,
        "連節バスの後ろ半分"@ja .

