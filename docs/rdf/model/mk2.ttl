@prefix cls: <https://nakamura196.github.io/train-bodies/rdf/class/> .
@prefix mdl: <https://nakamura196.github.io/train-bodies/rdf/model/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix tb: <https://nakamura196.github.io/train-bodies/vocab#> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

mdl:mk2 a schema:3DModel ;
    tb:galleryGroup "skytrain" ;
    tb:livery <https://nakamura196.github.io/train-bodies/rdf/model/mk2#livery> ;
    schema:about cls:tb-skytrain-mk2 ;
    schema:contentUrl <https://nakamura196.github.io/train-bodies/models/mk2.glb> ;
    schema:depth [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 149.7 ] ;
    schema:description "丸い鼻と大きな前面ガラス。2002年から。"@ja ;
    schema:encodingFormat "model/gltf-binary" ;
    schema:height [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 37.6 ] ;
    schema:name "Mark II"@ja ;
    schema:subjectOf <https://nakamura196.github.io/train-bodies/iiif/mk2/manifest.json> ;
    schema:thumbnailUrl <https://nakamura196.github.io/train-bodies/thumbs/mk2.jpg> ;
    schema:url <https://nakamura196.github.io/train-bodies/#mk2> ;
    schema:width [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 40.0 ] .

<https://nakamura196.github.io/train-bodies/rdf/model/mk2#livery> a tb:Livery ;
    rdfs:label "TransLink livery"@en,
        "TransLink の塗装"@ja ;
    tb:liveryOf wd:Q1142140 .

