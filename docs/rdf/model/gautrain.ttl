@prefix cls: <https://w3id.org/railclass/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix mdl: <https://w3id.org/railclass/model/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix tb: <https://w3id.org/railclass/vocab#> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix wdt: <http://www.wikidata.org/prop/direct/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

mdl:gautrain a schema:3DModel ;
    schema:about cls:tb-gautrain ;
    schema:contentUrl <https://railclass.ldas.jp/models/gautrain.glb> ;
    schema:depth [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 149.9 ] ;
    schema:description "南アフリカ・ハウテン州の空港連絡と通勤の電車。2010年開業時からのシャンパンゴールドの塗装。"@ja ;
    schema:encodingFormat "model/gltf-binary" ;
    schema:height [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 38.0 ] ;
    schema:license <https://creativecommons.org/licenses/by/4.0/> ;
    schema:name "ハウトレイン"@ja ;
    schema:subjectOf <https://railclass.ldas.jp/iiif/gautrain/manifest.json> ;
    schema:thumbnailUrl <https://railclass.ldas.jp/thumbs/gautrain.jpg> ;
    schema:url <https://railclass.ldas.jp/view.html#gautrain> ;
    schema:width [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 40.0 ] ;
    tb:galleryGroup "world" ;
    tb:livery <https://w3id.org/railclass/model/gautrain#livery> .

<https://w3id.org/railclass/model/gautrain#color1> a tb:ColorSample ;
    rdfs:label "champagne" ;
    wdt:P462 wd:Q39338 ;
    schema:color "#D6C9A2" ;
    tb:areaShare 0.8177 .

<https://w3id.org/railclass/model/gautrain#color2> a tb:ColorSample ;
    rdfs:label "screen" ;
    wdt:P462 wd:Q42519 ;
    schema:color "#242A32" ;
    tb:areaShare 0.0499 .

<https://w3id.org/railclass/model/gautrain#color3> a tb:ColorSample ;
    rdfs:label "gold" ;
    wdt:P462 wd:Q39338 ;
    schema:color "#B08A3E" ;
    tb:areaShare 0.0464 .

<https://w3id.org/railclass/model/gautrain#color4> a tb:ColorSample ;
    rdfs:label "royal" ;
    wdt:P462 wd:Q1088 ;
    schema:color "#1F3C9C" ;
    tb:areaShare 0.0376 .

<https://w3id.org/railclass/model/gautrain#color5> a tb:ColorSample ;
    rdfs:label "black" ;
    wdt:P462 wd:Q23445 ;
    schema:color "#14161A" ;
    tb:areaShare 0.0341 .

<https://w3id.org/railclass/model/gautrain#color6> a tb:ColorSample ;
    rdfs:label "orange" ;
    wdt:P462 wd:Q39338 ;
    schema:color "#D8602A" ;
    tb:areaShare 0.0098 .

<https://w3id.org/railclass/model/gautrain#livery> a tb:Livery ;
    rdfs:label "Gautrain livery (champagne gold, from the 2010 opening)"@en,
        "ハウトレインの塗装（シャンパンゴールド、2010年の開業から）"@ja ;
    dcterms:source "Colours taken automatically from the face materials of skytrain/out/gautrain/za_gautrain.obj (area share of the painted surface, kept when >= 1.5%, white/grey/black when >= 20%; the colour samples keep them all; tools/extract_colors.py)"@en ;
    wdt:P462 wd:Q1088,
        wd:Q39338 ;
    tb:colorSample <https://w3id.org/railclass/model/gautrain#color1>,
        <https://w3id.org/railclass/model/gautrain#color2>,
        <https://w3id.org/railclass/model/gautrain#color3>,
        <https://w3id.org/railclass/model/gautrain#color4>,
        <https://w3id.org/railclass/model/gautrain#color5>,
        <https://w3id.org/railclass/model/gautrain#color6> ;
    tb:liveryOf wd:Q84945092 .

