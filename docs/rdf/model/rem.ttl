mdl:rem a schema:3DModel ;
    schema:about cls:Q121749358 ;
    schema:contentUrl <https://railclass-models.ldas.jp/files/railclass/rem.glb> ;
    schema:depth [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 150.0 ] ;
    schema:description "カナダ・モントリオールの自動運転の電車。黒い前面を黄緑の輪が囲む。"@ja ;
    schema:encodingFormat "model/gltf-binary" ;
    schema:height [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 38.0 ] ;
    schema:license <http://rightsstatements.org/vocab/InC/1.0/> ;
    schema:name "REM（モントリオール）"@ja ;
    schema:subjectOf <https://railclass.ldas.jp/iiif/rem/manifest.json> ;
    schema:thumbnailUrl <https://railclass.ldas.jp/thumbs/rem.jpg> ;
    schema:url <https://railclass.ldas.jp/view.html#rem> ;
    schema:width [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 40.0 ] ;
    tb:galleryGroup "world" ;
    tb:livery <https://w3id.org/railclass/model/rem#livery> .

