@prefix cls: <https://w3id.org/railclass/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix mdl: <https://w3id.org/railclass/model/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix tb: <https://w3id.org/railclass/vocab#> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix wdt: <http://www.wikidata.org/prop/direct/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

mdl:venture a schema:3DModel ;
    schema:about cls:Q96106536 ;
    schema:contentUrl <https://railclass-models.ldas.jp/files/railclass/venture.glb> ;
    schema:depth [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 149.3 ] ;
    schema:description "カナダの都市間列車の新しい客車。運転台付きの車で、灰と黄の塗装。"@ja ;
    schema:encodingFormat "model/gltf-binary" ;
    schema:height [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 37.7 ] ;
    schema:license <http://rightsstatements.org/vocab/InC/1.0/> ;
    schema:name "ベンチャー（VIA Rail）"@ja ;
    schema:subjectOf <https://railclass.ldas.jp/iiif/venture/manifest.json> ;
    schema:thumbnailUrl <https://railclass.ldas.jp/thumbs/venture.jpg> ;
    schema:url <https://railclass.ldas.jp/view.html#venture> ;
    schema:width [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 40.0 ] ;
    tb:galleryGroup "world" ;
    tb:livery <https://w3id.org/railclass/model/venture#livery> .

