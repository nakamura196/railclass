<https://w3id.org/railclass/model/venture#livery> a tb:Livery ;
    rdfs:label "VIA Rail Venture livery (grey, charcoal and yellow)"@en,
        "VIA 鉄道のベンチャーの塗装（灰、濃い灰、黄）"@ja ;
    dcterms:source "Colours taken automatically from the face materials of skytrain/out/venture/via_venture.obj (area share of the painted surface, kept when >= 1.5%, white/grey/black when >= 20%; the colour samples keep them all; tools/extract_colors.py)"@en ;
    wdt:P462 wd:Q42519,
