@prefix cls: <https://w3id.org/railclass/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix mdl: <https://w3id.org/railclass/model/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix tb: <https://w3id.org/railclass/vocab#> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix wdt: <http://www.wikidata.org/prop/direct/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

mdl:mk3 a schema:3DModel ;
    schema:about cls:tb-skytrain-mk3 ;
    schema:contentUrl <https://railclass.ldas.jp/models/mk3.glb> ;
    schema:depth [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 152.0 ] ;
    schema:description "Innovia Metro 300。2016年から。"@ja ;
    schema:encodingFormat "model/gltf-binary" ;
    schema:height [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 37.6 ] ;
    schema:license <https://creativecommons.org/licenses/by/4.0/> ;
    schema:name "Mark III"@ja ;
    schema:subjectOf <https://railclass.ldas.jp/iiif/mk3/manifest.json> ;
    schema:thumbnailUrl <https://railclass.ldas.jp/thumbs/mk3.jpg> ;
    schema:url <https://railclass.ldas.jp/view.html#mk3> ;
    schema:width [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 40.0 ] ;
    tb:galleryGroup "skytrain" ;
    tb:livery <https://w3id.org/railclass/model/mk3#livery> .

<https://w3id.org/railclass/model/mk3#color1> a tb:ColorSample ;
    rdfs:label "charcoal" ;
    wdt:P462 wd:Q42519 ;
    schema:color "#2E3339" ;
    tb:areaShare 0.5895 .

<https://w3id.org/railclass/model/mk3#color2> a tb:ColorSample ;
    rdfs:label "blue" ;
    wdt:P462 wd:Q1088 ;
    schema:color "#1E4FA8" ;
    tb:areaShare 0.2188 .

<https://w3id.org/railclass/model/mk3#color3> a tb:ColorSample ;
    rdfs:label "roof" ;
    wdt:P462 wd:Q42519 ;
    schema:color "#A6ABB2" ;
    tb:areaShare 0.0933 .

<https://w3id.org/railclass/model/mk3#color4> a tb:ColorSample ;
    rdfs:label "black" ;
    wdt:P462 wd:Q23445 ;
    schema:color "#14161A" ;
    tb:areaShare 0.0756 .

<https://w3id.org/railclass/model/mk3#color5> a tb:ColorSample ;
    rdfs:label "silver" ;
    wdt:P462 wd:Q42519 ;
    schema:color "#BCC1C8" ;
    tb:areaShare 0.0073 .

<https://w3id.org/railclass/model/mk3#livery> a tb:Livery ;
    rdfs:label "TransLink livery"@en,
        "TransLink の塗装"@ja ;
    dcterms:source "Colours taken automatically from the face materials of skytrain/out/mk3/skytrain_mk3.obj (area share of the painted surface, kept when >= 1.5%, white/grey/black when >= 20%; the colour samples keep them all; tools/extract_colors.py)"@en ;
    wdt:P462 wd:Q1088,
        wd:Q42519 ;
    tb:colorSample <https://w3id.org/railclass/model/mk3#color1>,
        <https://w3id.org/railclass/model/mk3#color2>,
        <https://w3id.org/railclass/model/mk3#color3>,
        <https://w3id.org/railclass/model/mk3#color4>,
        <https://w3id.org/railclass/model/mk3#color5> ;
    tb:liveryOf wd:Q1142140 .

