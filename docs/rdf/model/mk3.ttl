mdl:mk3 a schema:3DModel ;
    tb:galleryGroup "skytrain" ;
    tb:livery <https://nakamura196.github.io/train-bodies/rdf/model/mk3#livery> ;
    schema:about cls:tb-skytrain-mk3 ;
    schema:contentUrl <https://nakamura196.github.io/train-bodies/models/mk3.glb> ;
    schema:depth [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 152.0 ] ;
    schema:description "Innovia Metro 300。2016年から。"@ja ;
    schema:encodingFormat "model/gltf-binary" ;
    schema:height [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 37.6 ] ;
    schema:license <https://creativecommons.org/licenses/by/4.0/> ;
    schema:name "Mark III"@ja ;
    schema:subjectOf <https://nakamura196.github.io/train-bodies/iiif/mk3/manifest.json> ;
    schema:thumbnailUrl <https://nakamura196.github.io/train-bodies/thumbs/mk3.jpg> ;
    schema:url <https://nakamura196.github.io/train-bodies/view.html#mk3> ;
    schema:width [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 40.0 ] .

