@prefix cls: <https://w3id.org/railclass/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix mdl: <https://w3id.org/railclass/model/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix tb: <https://w3id.org/railclass/vocab#> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix wdt: <http://www.wikidata.org/prop/direct/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

mdl:addis a schema:3DModel ;
    schema:about cls:tb-addis ;
    schema:contentUrl <https://railclass.ldas.jp/models/addis.glb> ;
    schema:depth [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 149.9 ] ;
    schema:description "エチオピアの路面電車。2015年開業、東西線の白と緑の塗装。"@ja ;
    schema:encodingFormat "model/gltf-binary" ;
    schema:height [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 40.0 ] ;
    schema:license <https://creativecommons.org/licenses/by/4.0/> ;
    schema:name "アディスアベバ・ライトレール"@ja ;
    schema:subjectOf <https://railclass.ldas.jp/iiif/addis/manifest.json> ;
    schema:thumbnailUrl <https://railclass.ldas.jp/thumbs/addis.jpg> ;
    schema:url <https://railclass.ldas.jp/view.html#addis> ;
    schema:width [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 40.0 ] ;
    tb:galleryGroup "world" ;
    tb:livery <https://w3id.org/railclass/model/addis#livery> .

<https://w3id.org/railclass/model/addis#color1> a tb:ColorSample ;
    rdfs:label "body" ;
    wdt:P462 wd:Q23444 ;
    schema:color "#F2F4F2" ;
    tb:areaShare 0.7946 .

<https://w3id.org/railclass/model/addis#color2> a tb:ColorSample ;
    rdfs:label "green" ;
    wdt:P462 wd:Q3133 ;
    schema:color "#1F9A60" ;
    tb:areaShare 0.1478 .

<https://w3id.org/railclass/model/addis#color3> a tb:ColorSample ;
    rdfs:label "black" ;
    wdt:P462 wd:Q23445 ;
    schema:color "#14161A" ;
    tb:areaShare 0.0467 .

<https://w3id.org/railclass/model/addis#livery> a tb:Livery ;
    rdfs:label "Addis Ababa Light Rail East-West (green) line livery (white and green)"@en,
        "アディスアベバ・ライトレール東西線（緑線）の塗装（白と緑）"@ja ;
    dcterms:source "Colours taken automatically from the face materials of skytrain/out/addis/aalrt_addis.obj (area share of the painted surface, kept when >= 1.5%, white/grey/black when >= 20%; the colour samples keep them all; tools/extract_colors.py)"@en ;
    wdt:P462 wd:Q23444,
        wd:Q3133 ;
    tb:colorSample <https://w3id.org/railclass/model/addis#color1>,
        <https://w3id.org/railclass/model/addis#color2>,
        <https://w3id.org/railclass/model/addis#color3> ;
    tb:liveryOf wd:Q55639671 .

