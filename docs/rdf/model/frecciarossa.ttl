    schema:thumbnailUrl <https://railclass.ldas.jp/thumbs/frecciarossa.jpg> ;
    schema:url <https://railclass.ldas.jp/view.html#frecciarossa> ;
    schema:width [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 40.0 ] ;
    tb:galleryGroup "world" ;
    tb:livery <https://w3id.org/railclass/model/frecciarossa#livery> .

