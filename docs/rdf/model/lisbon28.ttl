mdl:lisbon28 a schema:3DModel ;
    schema:about cls:tb-lisbon28 ;
    schema:contentUrl <https://railclass.ldas.jp/models/lisbon28.glb> ;
    schema:depth [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 149.5 ] ;
    schema:description "リスボンの坂を走る2軸の路面電車（Remodelado）。黄と白の塗装。"@ja ;
    schema:encodingFormat "model/gltf-binary" ;
    schema:height [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 46.0 ] ;
    schema:license <https://creativecommons.org/licenses/by/4.0/> ;
    schema:name "リスボン市電 28番線"@ja ;
    schema:subjectOf <https://railclass.ldas.jp/iiif/lisbon28/manifest.json> ;
    schema:thumbnailUrl <https://railclass.ldas.jp/thumbs/lisbon28.jpg> ;
    schema:url <https://railclass.ldas.jp/view.html#lisbon28> ;
    schema:width [ a schema:QuantitativeValue ;
            schema:unitCode "MMT" ;
            schema:value 40.0 ] ;
    tb:galleryGroup "world" ;
    tb:livery <https://w3id.org/railclass/model/lisbon28#livery> .

