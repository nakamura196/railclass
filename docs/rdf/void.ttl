<https://w3id.org/railclass/dataset#allJsonld> a dcat:Distribution ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:title "All classes and models (JSON-LD)"@en,
        "全形式と 3D モデル（JSON-LD）"@ja ;
    dcat:byteSize "18913575"^^xsd:nonNegativeInteger ;
    dcat:downloadURL <https://railclass.ldas.jp/rdf/all.jsonld> ;
    dcat:mediaType "application/ld+json" .

<https://w3id.org/railclass/dataset#allTtl> a dcat:Distribution ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:title "All classes and models (Turtle)"@en,
        "全形式と 3D モデル（Turtle）"@ja ;
    dcat:byteSize "9122872"^^xsd:nonNegativeInteger ;
    dcat:downloadURL <https://railclass.ldas.jp/rdf/all.ttl> ;
    dcat:mediaType "text/turtle" .

<https://w3id.org/railclass/dataset#eratv> a dcat:Distribution ;
    dcterms:conformsTo <http://www.w3.org/ns/csvw> ;
    dcterms:rights "Type IDs and names: source European Union Agency for Railways (ERATV); reproduction is authorised provided the source is acknowledged (https://www.era.europa.eu/content/disclaimer-and-copyright-notice). Wikidata identifiers: CC0."@en ;
    dcterms:title "ERATV types matched to Wikidata classes (TSV + CSVW)"@en,
        "ERATV の型式と Wikidata の形式の対応表（TSV と CSVW）"@ja ;
    dcat:byteSize "66393"^^xsd:nonNegativeInteger ;
    dcat:downloadURL <https://railclass.ldas.jp/data/eratv-wikidata.tsv> ;
    dcat:mediaType "text/tab-separated-values" .

<https://w3id.org/railclass/dataset#iiif> a dcat:Distribution ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:title "IIIF Presentation 4.0 Collection of the 3D models"@en,
        "3D モデルの IIIF Collection（Presentation 4.0）"@ja ;
    dcat:byteSize "27583"^^xsd:nonNegativeInteger ;
    dcat:downloadURL <https://railclass.ldas.jp/iiif/collection.json> ;
    dcat:mediaType "application/ld+json" .

<https://w3id.org/railclass/dataset#lines> a dcat:Distribution ;
    dcterms:license <https://opendatacommons.org/licenses/odbl/1-0/> ;
    dcterms:rights "© OpenStreetMap contributors, ODbL. Only the line IDs (Wikidata items) are in the RDF."@en ;
    dcterms:title "Line shapes from OpenStreetMap (GeoJSON, one file per line)"@en,
        "路線の線（OpenStreetMap、GeoJSON、路線ごとのファイル）"@ja ;
    dcat:byteSize "1111463"^^xsd:nonNegativeInteger ;
    dcat:downloadURL <https://railclass.ldas.jp/lines/_all.geojson> ;
    dcat:mediaType "application/geo+json" .

<https://w3id.org/railclass/dataset#links-commons> a void:Linkset ;
    void:linkPredicate foaf:depiction ;
    void:objectsTarget <http://commons.wikimedia.org/> ;
    void:subjectsTarget cls:dataset ;
    void:triples 10402 .

<https://w3id.org/railclass/dataset#links-wikidata> a void:Linkset ;
    void:linkPredicate skos:exactMatch ;
    void:objectsTarget <http://www.wikidata.org/> ;
    void:subjectsTarget cls:dataset ;
    void:triples 14325 .

<https://w3id.org/railclass/dataset#models> a dcat:Distribution ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:title "List of the 3D models (JSON)"@en,
        "3D モデルの一覧（JSON）"@ja ;
    dcat:byteSize "33588"^^xsd:nonNegativeInteger ;
    dcat:downloadURL <https://railclass.ldas.jp/data/models.json> ;
    dcat:mediaType "application/json" .

<https://w3id.org/railclass/dataset#vocab> a dcat:Distribution ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:title "Terms of our own (tb:)"@en,
        "独自の語彙（tb:）"@ja ;
    dcat:byteSize "5223"^^xsd:nonNegativeInteger ;
    dcat:downloadURL <https://railclass.ldas.jp/rdf/vocab.ttl> ;
    dcat:mediaType "text/turtle" .

cls:dataset a void:Dataset,
        dcat:Dataset ;
    dcterms:creator _:N7169986671c344a3b64ebddbb2dfe71d ;
    dcterms:description "14,339 railway vehicle classes outside Japan, taken from Wikidata and linked to it (skos:exactMatch), with operator, manufacturer and other values as Wikidata IRIs, photos for 10,402 classes (Wikimedia Commons), the lines 933 classes run on, and 69 3D-printed vehicle bodies with their liveries. No SPARQL endpoint: every resource is a static file (Turtle and JSON-LD), and the whole dataset is in one dump file."@en,
        "日本を除く世界の鉄道車両の形式 14,339 件。Wikidata から取り出し、skos:exactMatch で結んでいる。運行者・製造者などの値は Wikidata の IRI のまま持つ。写真 10,402 形式（Wikimedia Commons）、走る路線 933 形式、3D プリントで作った車体 69 件とその塗装を含む。SPARQL エンドポイントは無い。資源はすべて静的なファイル（Turtle と JSON-LD）で、全体は一括ファイル 1 つにまとめてある。"@ja ;
    dcterms:isReferencedBy <https://github.com/nakamura196/railclass> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:modified "2026-10-13"^^xsd:date ;
    dcterms:publisher _:N7169986671c344a3b64ebddbb2dfe71d ;
    dcterms:rights "Class data CC0. 3D models (schema:3DModel and their files) CC BY 4.0, stated on each model with schema:license. Photos: the licence of each Wikimedia Commons file."@en ;
    dcterms:source wd:Q2013 ;
    dcterms:title "RailClass: railway vehicle classes of the world"@en,
        "RailClass: 世界の鉄道車両の形式"@ja ;
    void:classPartition [ void:class skos:Concept ;
            void:entities 14339 ],
        [ void:class schema:QuantitativeValue ;
            void:entities 207 ],
        [ void:class rdf:Property ;
            void:entities 16 ],
        [ void:class rdfs:Class ;
            void:entities 4 ],
        [ void:class tb:ColorSample ;
            void:entities 479 ],
        [ void:class skos:ConceptScheme ;
            void:entities 1 ],
        [ void:class tb:Livery ;
            void:entities 69 ],
        [ void:class schema:3DModel ;
            void:entities 69 ],
        [ void:class tb:LineUse ;
            void:entities 2500 ],
        [ void:class tb:VehicleClass ;
            void:entities 14339 ] ;
    void:dataDump <https://railclass.ldas.jp/rdf/all.jsonld>,
        <https://railclass.ldas.jp/rdf/all.ttl> ;
    void:distinctSubjects 17477 ;
    void:entities 17477 ;
    void:exampleResource cls:Q115612330,
        cls:Q696668,
        mdl:icet_411,
        cls:tb-skytrain-mk2 ;
    void:feature <http://www.w3.org/ns/formats/JSON-LD>,
        <http://www.w3.org/ns/formats/Turtle> ;
