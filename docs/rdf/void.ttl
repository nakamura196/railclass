        <http://www.wikidata.org/prop/direct/>,
        foaf:,
        schema:,
        tb: ;
    rdfs:comment "There is no SPARQL endpoint. Load the dump (void:dataDump) into a triple store, or read single resources: each URI (a class <https://w3id.org/railclass/{id}>, a model <https://w3id.org/railclass/model/{id}>) is sent by w3id.org to its Turtle file, JSON-LD file or human page by the Accept header (text/turtle, application/ld+json, anything else)."@en ;
    dcat:distribution <https://w3id.org/railclass/dataset#allJsonld>,
        <https://w3id.org/railclass/dataset#allTtl>,
        <https://w3id.org/railclass/dataset#eratv>,
        <https://w3id.org/railclass/dataset#iiif>,
        <https://w3id.org/railclass/dataset#lines>,
        <https://w3id.org/railclass/dataset#models>,
        <https://w3id.org/railclass/dataset#vocab> ;
    dcat:keyword "3D model",
        "Wikidata",
        "railway",
        "rolling stock",
        "vehicle class",
        "形式",
        "鉄道車両" ;
    dcat:landingPage <https://railclass.ldas.jp/dataset.html> ;
    foaf:homepage <https://railclass.ldas.jp/> .

