---
// Top page. Everything is written into the HTML at build time (counts, newest models, news), so it shows without JS.
import "../styles/top.css";
import Base from "../layouts/Base.astro";
import { page, file, t, type Lang } from "../i18n";
import { models, newest, news, stats } from "../lib/data";
import { SHOW3D } from "../lib/site";
// Imported only when show3d is true: Astro puts the CSS and scripts of every statically imported component into the page, rendered or not
const TopHero3D = SHOW3D ? (await import("./TopHero3D.astro")).default : null;
const TopNew3D = SHOW3D ? (await import("./TopNew3D.astro")).default : null;

const { lang } = Astro.props as { lang: Lang };
const ui = t(lang);
const T = ui.top;
// show3d false (site.config.json): no hero model, no model count, no 3D features, no new-models list, no model data links
const M = SHOW3D ? models(lang) : { ext: "", groups: [], items: [] };
const items = newest(M.items);
const hero = SHOW3D ? (items.find(it => it.group !== "bus") ?? items[0]) : undefined;   // the hero shows a train: this is a railway site first
const heroPath = hero ? `${hero.id}.${M.ext}` : "";
const S = stats();
const num = (k: string) => (typeof S?.[k] === "number" ? S[k].toLocaleString(ui.numberLocale) : "—");
const F = T.features;
const list3d = page(lang, "search/") + "?has3d=1";
const D = T.dataItems;
---
<Base lang={lang} path="" current="top">
{SHOW3D && <script slot="head" type="module" src="https://cdn.jsdelivr.net/npm/@google/model-viewer@3.5.0/dist/model-viewer.min.js"></script>}
<main class="top">
  <section class="hero">
    <div class={hero ? "wrap" : "wrap solo"}>
      <div class="lead">
        <h1>{T.title}</h1>
        <p>{T.lead}</p>
        <form class="find" action={page(lang, "search/")} role="search">
          <label for="q">{T.findLabel}</label>
          <div>
            <input id="q" name="q" type="search" placeholder={T.findPlaceholder} autocomplete="off">
            <button type="submit">{T.findButton}</button>
          </div>
        </form>
      </div>
      {hero && TopHero3D && <TopHero3D lang={lang} hero={hero} path={heroPath} />}
    </div>
  </section>

  <section class="stats" aria-label={T.statsLabel}>
    <div class="wrap">
      <dl>
        {(SHOW3D ? ["classes", "models", "countries"] : ["classes", "countries"] as const).map(k => <div><dt>{T.stats[k]}</dt><dd>{num(k)}</dd></div>)}
      </dl>
    </div>
  </section>

  <section class="block" id="features" aria-labelledby="features-h">
    <div class="wrap">
      <h2 id="features-h">{T.featuresTitle}</h2>
      <ul class="features">
        <li><a href={page(lang, "search/")}><b>{F.search[0]}</b><span>{F.search[1]}</span></a></li>
        <li><a href={page(lang, "map/")}><b>{F.map[0]}</b><span>{F.map[1]}</span></a></li>
        {SHOW3D && <li><a href={list3d}><b>{F.view[0]}</b><span>{F.view[1]}</span></a></li>}
        {SHOW3D && <li><a href={list3d}><b>{F.download[0]}</b><span>{F.download[1]}</span></a></li>}
        <li><a href={page(lang, "dataset.html")}><b>{F.data[0]}</b><span>{F.data[1]}</span></a></li>
      </ul>
    </div>
  </section>

  {TopNew3D && <TopNew3D lang={lang} items={items.slice(0, 6)} />}

  <div class="wrap pair">
    <section class="block" id="news" aria-labelledby="news-h">
      <h2 id="news-h">{T.newsTitle}</h2>
      <ol class="news">
        {news(lang).slice(0, 5).map((n: any) => (
          <li>
            <time datetime={n.date}>{n.date}</time>
            <b>{n.url ? <a href={/^https?:/.test(n.url) ? n.url : page(lang, n.url)}>{n.title}</a> : n.title}</b>
            {n.body && <p>{n.body}</p>}
          </li>
        ))}
      </ol>
    </section>
    <section class="block" id="about" aria-labelledby="about-h">
      <h2 id="about-h">{T.aboutTitle}</h2>
      {T.about.map(p => <p>{p}</p>)}
    </section>
  </div>

  <section class="block" id="data" aria-labelledby="data-h">
    <div class="wrap">
      <h2 id="data-h">{T.dataTitle}</h2>
      <ul class="data">
        <li><a href={page(lang, "dataset.html")}><b>{D.dataset[0]}</b></a><span>{D.dataset[1]}</span></li>
        {SHOW3D && <li><a href={file("data/models.json")}>{D.models[0]}</a><span>{D.models[1]}</span></li>}
        <li><a href={file("rdf/all.ttl")}>{D.rdf[0]}</a><span>{D.rdf[1]} (<a href={file("rdf/all.ttl")}>Turtle</a> · <a href={file("rdf/all.jsonld")}>JSON-LD</a>)</span></li>
        {SHOW3D && <li><a href={file("iiif/collection.json")}>{D.iiif[0]}</a><span>{D.iiif[1]}</span></li>}
        {SHOW3D && <li><a href={list3d}>{D.download[0]}</a><span>{D.download[1]}</span></li>}
      </ul>
    </div>
  </section>
</main>
{SHOW3D && <script is:inline>
// Old links to the viewer (index.html#mk1) go to view.html#mk1; hashes of sections on this page stay here.
(() => { const h = location.hash.slice(1); if (h && !document.getElementById(h)) location.replace("view.html" + location.hash); })();
</script>}
</Base>

