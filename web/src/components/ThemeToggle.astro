---
// One button cycling "follow OS → light → dark". The choice is stored in localStorage (read in Base.astro's head).
import { t, type Lang } from "../i18n";
const { lang } = Astro.props as { lang: Lang };
const ui = t(lang).theme;
---
<button type="button" class="theme-toggle" data-labels={JSON.stringify(ui)}>
  <svg class="i-system" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8" /><path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor" stroke="none" /></svg>
  <svg class="i-light" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M4.9 19.1 7 17M17 7l2.1-2.1" /></svg>
  <svg class="i-dark" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" /></svg>
  <span class="theme-text"></span>
</button>
<script>
  const ORDER = ["system", "light", "dark"] as const;
  type Mode = (typeof ORDER)[number];
  const root = document.documentElement;
  const current = (): Mode => (root.dataset.theme === "light" || root.dataset.theme === "dark" ? root.dataset.theme : "system");
  for (const btn of document.querySelectorAll<HTMLButtonElement>(".theme-toggle")) {
    const L = JSON.parse(btn.dataset.labels!);
    const paint = () => {
      const m = current();
      btn.dataset.mode = m;
      btn.querySelector(".theme-text")!.textContent = L[m];
      btn.title = `${L.label}: ${L[m]}（${L.next}）`;
      btn.setAttribute("aria-label", `${L.label}: ${L[m]}`);
    };
    btn.addEventListener("click", () => {
      const next = ORDER[(ORDER.indexOf(current()) + 1) % ORDER.length];
      if (next === "system") delete root.dataset.theme; else root.dataset.theme = next;
      try { next === "system" ? localStorage.removeItem("theme") : localStorage.setItem("theme", next); } catch (e) {}
      paint();
    });
    paint();
  }
</script>
