---
import { page, jaOnly, file, t, type Lang } from "../i18n";
const { lang } = Astro.props as { lang: Lang };
const ui = t(lang);
const f = ui.footer;
const siteLinks = [[ui.nav.search, jaOnly("search/")], [ui.nav.view, page(lang, "view.html")], [f.news, page(lang, "#news")], [ui.nav.about, page(lang, "#about")]];
const dataLinks = [[f.modelsJson, file("data/models.json")], [f.newsJson, file("data/news.json")], [f.source, "https://github.com/nakamura196/train-bodies"]];
---
<footer class="site-footer">
  <div class="wrap">
    <div>
      <p><b>{ui.site.name}</b>{f.lead}</p>
      <p>{ui.site.author}</p>
    </div>
    <div><h2>{f.site}</h2><ul>{siteLinks.map(([l, h]) => <li><a href={h}>{l}</a></li>)}</ul></div>
    <div><h2>{f.data}</h2><ul>{dataLinks.map(([l, h]) => <li><a href={h}>{l}</a></li>)}</ul></div>
    <div class="legal">
      <p>{f.unofficial}</p>
      <p>{f.licence}</p>
      <p>{f.copyright}</p>
    </div>
  </div>
</footer>
