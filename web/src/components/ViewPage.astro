---
// view.html is kept only so that old links still work: the models are now shown on their class pages
// (rdf/class/<id>.html, with the part annotations), and the list of them is the search with "has a 3D model".
// view.html#<model-id> goes to that model on its class page; view.html alone goes to search/?has3d=1.
// Without a script the page shows the same links.
import Base from "../layouts/Base.astro";
import { page, t, type Lang } from "../i18n";
import { models } from "../lib/data";
import { modelClasses } from "../lib/classes";

const { lang } = Astro.props as { lang: Lang };
const ui = t(lang);
const V = ui.view;
const M = models(lang);
const where = modelClasses();
const to = Object.fromEntries(M.items.filter(it => where[it.id]).map(it => [it.id, page(lang, `rdf/class/${where[it.id]}.html#${it.id}`)]));
const list = page(lang, "search/") + "?has3d=1";
---
<Base lang={lang} path="view.html" current="view" title={`${V.title} — ${ui.site.name}`} description={V.description}>
<meta slot="head" name="robots" content="noindex">
<div class="wrap" style="padding-block: 20px">
  <h1>{V.title}</h1>
  <p>{V.moved} <a href={list}>{V.movedList}</a></p>
  <ul>
    {M.items.filter(it => to[it.id]).map(it => <li><a href={to[it.id]}>{it.title}</a></li>)}
  </ul>
</div>
<script type="application/json" id="view-to" set:html={JSON.stringify({ to, list })} />
</Base>

<script>
  const { to, list } = JSON.parse(document.getElementById("view-to")!.textContent!);
  location.replace(to[location.hash.slice(1)] ?? list);
</script>
