---
// One class (rdf/class/<id>.html): name, the values (as in the search), links to Wikidata and the broader / narrower
// classes and the RDF itself. With show3d true (site.config.json) it also shows the 3D models made for the class
// (components/Class3D.astro: viewer with the part annotations of the IIIF Manifest; rdf/class/<id>.html#<model-id> opens that model)
// and their links in the export box (components/Class3DExports.astro). With show3d false nothing of that is rendered.
import "../styles/class.css";
import Base from "../layouts/Base.astro";
import { file, page, t, type Lang } from "../i18n";
import { classPage } from "../lib/classes";
import { classLines, downloads } from "../lib/data";
import { SHOW3D } from "../lib/site";
// Imported only when show3d is true: Astro puts the CSS and scripts of every statically imported component into the page, rendered or not
const Class3D = SHOW3D ? (await import("./Class3D.astro")).default : null;
const Class3DExports = SHOW3D ? (await import("./Class3DExports.astro")).default : null;
import { ldBrowser } from "../lib/ldbrowser";

const { lang, id } = Astro.props as { lang: Lang; id: string };
const ui = t(lang);
const T = ui.class;
const fmt = (s: string, o: Record<string, string | number>) => s.replace(/\{(\w+)\}/g, (_, k) => String(o[k]));
const nf = new Intl.NumberFormat(ui.numberLocale);
const c = classPage(id, lang, n => nf.format(n), y => fmt(T.year, { y }));
const uri = `https://w3id.org/railclass/${id}`;
const here = `rdf/class/${id}.html`;
const cite = `${c.name}. ${ui.site.name}. ${uri}`;
const cls = (x: string) => page(lang, `rdf/class/${x}.html`);
// Share image: the class's photo when the site has a local copy (photos/<key>.webp); a Wikimedia address is not used,
// because Wikimedia refuses Facebook's fetcher (403, checked 2026-10-14). Otherwise the site-wide image.
const share = c.photo && !c.photo.src.startsWith("http") ? { src: c.photo.src, alt: c.name, size: c.photo.size, type: "image/webp" } : undefined;
const lines = classLines(id);
const mapped = lines.filter(l => l.map);
---
<Base lang={lang} path={here} current="search" title={`${c.name} — ${ui.site.name}`} description={`${T.kicker}: ${c.name}${c.other ? ` (${c.other})` : ""}`}
  image={share}>
{SHOW3D && c.models.length > 0 && <script slot="head" type="module" src="https://cdn.jsdelivr.net/npm/@google/model-viewer@3.5.0/dist/model-viewer.min.js"></script>}
{mapped.length > 0 && <link slot="head" rel="stylesheet" href="https://cdn.jsdelivr.net/npm/maplibre-gl@5.6.0/dist/maplibre-gl.css">}
{mapped.length > 0 && <script slot="head" is:inline src="https://cdn.jsdelivr.net/npm/maplibre-gl@5.6.0/dist/maplibre-gl.js"></script>}
<link slot="head" rel="alternate" type="text/turtle" href={file(`rdf/class/${id}.ttl`)}>
<link slot="head" rel="alternate" type="application/ld+json" href={file(`rdf/class/${id}.jsonld`)}>
<div class="wrap cls">
  <p class="crumb"><a href={page(lang, "search/")}>{T.back}</a> / {T.kicker}</p>
  <div class="head">
    <h1>{c.name}</h1>
    {c.other && <p class="other">{c.other}</p>}
    <p class="uri"><code>{uri}</code> · <a href={ldBrowser(lang, uri)}>{ui.site.ldBrowser}</a></p>
  </div>

  {Class3D && c.models.length > 0 && <Class3D lang={lang} ids={c.models} />}

  <div class="body">
    <section class="props" aria-labelledby="h-values">
      <h2 id="h-values">{T.values}</h2>
      {c.facets.length ? (
        <>
          <dl>
            {c.facets.map(f => (
              <div><dt>{f.label}</dt><dd>{f.values.map((v, k) => (
                <>{k > 0 && <span class="sep">{lang === "ja" ? "・" : ", "}</span>}{v.search ? <a href={`${page(lang, "search/")}?${v.search}`}>{v.text}</a> : v.text}</>
              ))}</dd></div>
            ))}
          </dl>
          <p class="hint">{T.valuesHint}</p>
        </>
      ) : <p class="hint">{T.noValues}</p>}

      <h2>{T.links}</h2>
      <dl>
        {c.wikidata && <div><dt>{T.wikidata}</dt><dd><a href={`https://www.wikidata.org/wiki/${c.wikidata}`}>{c.wikidata}</a></dd></div>}
        {c.derivedFrom && !c.derivedFrom.endsWith("/" + c.wikidata) && <div><dt>{T.source}</dt><dd><a href={c.derivedFrom}>{c.derivedFrom}</a></dd></div>}
        {c.broader.length > 0 && <div><dt>{T.broader}</dt><dd>{c.broader.map((b, k) => <>{k > 0 && ", "}<a href={cls(b.id)}>{b.name}</a></>)}</dd></div>}
        {c.narrower.length > 0 && <div><dt>{T.narrower}</dt><dd>{c.narrower.map((b, k) => <>{k > 0 && ", "}<a href={cls(b.id)}>{b.name}</a></>)}</dd></div>}
      </dl>

      {lines.length > 0 && (
        <section class="lines" aria-labelledby="h-lines">
          <h2 id="h-lines">{T.lines}</h2>
          {mapped.length > 0 && (
            <div class="map">
              <div id="line-map" role="img" aria-label={T.lines}></div>
              <p class="credit"><a href="https://www.openstreetmap.org/copyright">{T.mapCredit}</a></p>
            </div>
          )}
          <ul>
            {lines.map(l => (
              <li data-line={l.id} class:list={{ old: l.status !== "current" }}>
                {l.map ? <button type="button" data-line={l.id}><span class="sw" style={`--c: ${l.color}`} aria-hidden="true"></span>{l.label}</button>
                       : <span class="name"><span class="sw none" aria-hidden="true"></span>{l.label}</span>}
                <span class="meta">
                  {l.until && <span>{fmt(T.until, { y: l.until })}</span>}
                  {!l.map && mapped.length > 0 && <span>{T.noMap}</span>}
                  <a href={`https://www.wikidata.org/wiki/${l.id}`}>{l.id}</a>
                  {l.source && !l.source.includes("wikidata.org") && <a href={l.source}>{T.lineSource}</a>}
                </span>
              </li>
            ))}
          </ul>
          {mapped.length > 1 && <button type="button" class="all-lines">{T.linesAll}</button>}
          {mapped.length > 0 && <p class="hint">{T.linesHint}</p>}
        </section>
      )}
    </section>

    <aside class="media">
      <section class="card" aria-labelledby="h-export">
        <h2 id="h-export">{T.exportHeading}</h2>
        <h3>{T.citation}</h3>
        <div class="cite">
          <p id="cite-text">{cite}</p>
          <button type="button" id="cite-copy" data-done={T.copied} title={T.copy} aria-label={T.copy}>
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" d="M9 9h10v12H9zM5 15V3h10"/></svg>
          </button>
        </div>
        <h3>{T.export}</h3>
        <div class="exports">
          <a href={file(`rdf/class/${id}.ttl`)} download>Turtle</a>
          <a href={file(`rdf/class/${id}.jsonld`)} download>JSON-LD</a>
          {Class3DExports && c.models.length > 0 && <Class3DExports lang={lang} ids={c.models} here={here} />}
        </div>
        {SHOW3D && c.models.some(m => downloads(m, lang).length) && <p class="dlnote">{ui.model.objNote} {ui.model.meshNote}</p>}
      </section>
      {c.photo && (
        <figure class="photo">
          <a href={c.photo.page}><img src={c.photo.src.startsWith("http") ? c.photo.src : file(c.photo.src)} alt={c.name} loading="lazy" decoding="async"></a>
          <figcaption>
            <a href={c.photo.page}>{c.photo.who ? fmt(T.photoBy, { who: c.photo.who }) : T.photoCommons}</a>
            {c.photo.lic && <> / {c.photo.licUrl ? <a href={c.photo.licUrl} rel="license">{c.photo.lic}</a> : c.photo.lic}</>}
          </figcaption>
        </figure>
      )}
    </aside>
  </div>

  <details class="ttl">
    <summary>{T.showTtl}</summary>
    <pre>{c.ttl}</pre>
  </details>
</div>
{mapped.length > 0 && <script type="application/json" id="lines-data" set:html={JSON.stringify(mapped.map(l => ({ id: l.id, label: l.label, old: l.status !== "current", color: l.color, src: file(`lines/${l.id}.geojson`) })))} />}
</Base>

<script>
  import { lineMap } from "../scripts/line-map";
  lineMap();

  // Copy the citation
  const cc = document.getElementById("cite-copy");
  cc?.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(document.getElementById("cite-text")!.textContent!);
      const t = cc.title; cc.title = cc.dataset.done!; cc.classList.add("done");
      setTimeout(() => { cc.title = t; cc.classList.remove("done"); }, 2000);
    } catch (e) {}
  });
</script>
