---
// One class (rdf/class/<id>.html): name, the values (as in the search), links to Wikidata and the broader / narrower
// classes, the 3D models made for it (viewer with the part annotations of the IIIF Manifest) and the RDF itself.
// Written at build time; the script only moves the camera to a part and switches between the class's models.
// rdf/class/<id>.html#<model-id> opens that model.
import "../styles/class.css";
import Base from "../layouts/Base.astro";
import { file, page, t, type Lang } from "../i18n";
import { classPage } from "../lib/classes";
import iiifLogo from "../assets/iiif-logo.svg";   // the IIIF logo, as on the IIIF Consortium's site
import { models, modelParts, fmtSize, hasManifest, classLines } from "../lib/data";

const { lang, id } = Astro.props as { lang: Lang; id: string };
const ui = t(lang);
const T = ui.class;
const fmt = (s: string, o: Record<string, string | number>) => s.replace(/\{(\w+)\}/g, (_, k) => String(o[k]));
const nf = new Intl.NumberFormat(ui.numberLocale);
const c = classPage(id, lang, n => nf.format(n), y => fmt(T.year, { y }));
const M = models(lang);
const mods = c.models.map(m => M.items.find(it => it.id === m)).filter(Boolean) as ReturnType<typeof models>["items"];
const V = ui.view;
const ORBITS: [keyof typeof V.orbits, string][] = [["quarter", "-55deg 70deg auto"], ["side", "0deg 90deg auto"], ["front", "-90deg 85deg auto"], ["top", "0deg 0deg auto"]];
// The surface normal at a part: build_iiif.py puts each part's camera at hit + normal * 55 + up * 12, so the normal is
// recovered from the camera. The script fades the markers whose surface faces away from the camera, as Sketchfab does.
const normal = (c: { pos: number[]; look: number[] } | null) => {
  if (!c) return null;
  const d = [c.pos[0] - c.look[0], c.pos[1] - c.look[1] - 12, c.pos[2] - c.look[2]];
  const n = Math.hypot(...d) || 1;
  return d.map(x => +(x / n).toFixed(3));
};
const parts = Object.fromEntries(mods.map(m => [m.id, modelParts(m.id, lang)]));
const mdata = mods.map(m => ({ id: m.id, src: file(`models/${m.id}.${M.ext}`), poster: file(`thumbs/${m.id}.jpg`),
  tag: `${fmtSize(m.size)} mm`, cams: parts[m.id].map(p => p.cam), marks: parts[m.id].map(p => ({ at: p.at, n: normal(p.cam) })) }));
const pos = (v: number[]) => v.map(x => `${x}m`).join(" ");

const uri = `https://nakamura196.github.io/train-bodies/rdf/class/${id}`;
const here = `rdf/class/${id}.html`;
const cite = `${c.name}. ${ui.site.name}. ${uri}`;
const cls = (x: string) => page(lang, `rdf/class/${x}.html`);
const lines = classLines(id);
const mapped = lines.filter(l => l.map);
---
<Base lang={lang} path={here} current="search" title={`${c.name} — ${ui.site.name}`} description={`${T.kicker}: ${c.name}${c.other ? ` (${c.other})` : ""}`}>
{mods.length > 0 && <script slot="head" type="module" src="https://cdn.jsdelivr.net/npm/@google/model-viewer@3.5.0/dist/model-viewer.min.js"></script>}
{mapped.length > 0 && <link slot="head" rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css">}
{mapped.length > 0 && <script slot="head" is:inline src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js"></script>}
<link slot="head" rel="alternate" type="text/turtle" href={file(`rdf/class/${id}.ttl`)}>
<link slot="head" rel="alternate" type="application/ld+json" href={file(`rdf/class/${id}.jsonld`)}>
<div class="wrap cls">
  <p class="crumb"><a href={page(lang, "search/")}>{T.back}</a> / {T.kicker}</p>
  <div class="head">
    <h1>{c.name}</h1>
    {c.other && <p class="other">{c.other}</p>}
    <p class="uri"><code>{uri}</code></p>
  </div>

  {mods.length > 0 && (
    <section class:list={["m3d", { solo: mods.every(m => !parts[m.id].length) }]} aria-labelledby="h-models">
      <div class="stage">
        <h2 id="h-models">{T.models}</h2>
        <div class="mat">
          <model-viewer id="mv" src={mdata[0].src} poster={mdata[0].poster} camera-controls touch-action="pan-y" shadow-intensity="0.8"
            tone-mapping="neutral" interaction-prompt="none" camera-orbit={ORBITS[0][1]} alt={V.alt}>
            {mods.map((m, mi) => parts[m.id].map((p, k) => (
              <button type="button" class="hs" slot={`hotspot-${m.id}-${k}`} data-model={m.id} data-part={k} data-position={pos(p.at)}
                hidden={mi > 0} aria-label={p.label}>{k + 1}</button>
            )))}
          </model-viewer>
          <span class="tag" id="tag">{mdata[0].tag}</span>
          <span class="hint">{V.hint}</span>
        </div>
        {mods.length > 1 && (
          <div class="views pick" role="group" aria-label={T.models}>
            {mods.map((m, i) => <button type="button" data-model={m.id} aria-pressed={i === 0 ? "true" : "false"}>{m.title}</button>)}
          </div>
        )}
        <div class="views orbits" role="group" aria-label={V.orient}>
          {ORBITS.map(([k, orbit], i) => <button type="button" data-orbit={orbit} aria-pressed={i === 0 ? "true" : "false"}>{V.orbits[k]}</button>)}
          <button type="button" id="spin" aria-pressed="false">{V.orbits.spin}</button>
          {mods.some(m => parts[m.id].length) && <button type="button" id="marks" aria-pressed="true">{T.marks}</button>}
        </div>
        {mods.map((m, i) => (
          <div class="about" data-model={m.id} hidden={i > 0}>
            <b>{m.title}</b>
            {m.line && <p>{m.line}</p>}
          </div>
        ))}
        <div class="note">{V.note.map(p => <p>{p}</p>)}</div>
      </div>
      <div class="parts">
        {mods.map((m, mi) => parts[m.id].length > 0 && (
          <div data-model={m.id} hidden={mi > 0}>
            <h2>{T.parts}</h2>
            <p class="hint">{T.partsHint}</p>
            <ol>
              {parts[m.id].map((p, k) => (
                <li data-kind={p.kindKey}>
                  <button type="button" data-model={m.id} data-part={k}><span class="n">{k + 1}</span><b>{p.label}</b>{p.kind && <span class="kind">{p.kind}</span>}</button>
                  <p>{p.text}</p>
                </li>
              ))}
            </ol>
            <button type="button" class="overview">{T.overview}</button>
          </div>
        ))}
      </div>
    </section>
  )}

  <div class="body">
    <section class="props" aria-labelledby="h-values">
      <h2 id="h-values">{T.values}</h2>
      {c.facets.length ? (
        <>
          <dl>
            {c.facets.map(f => (
              <div><dt>{f.label}</dt><dd>{f.values.map((v, k) => (
                <>{k > 0 && <span class="sep">{lang === "ja" ? "・" : ", "}</span>}{v.search ? <a href={`${page(lang, "search/")}?${v.search}`}>{v.text}</a> : v.text}</>
              ))}</dd></div>
            ))}
          </dl>
          <p class="hint">{T.valuesHint}</p>
        </>
      ) : <p class="hint">{T.noValues}</p>}

      <h2>{T.links}</h2>
      <dl>
        {c.wikidata && <div><dt>{T.wikidata}</dt><dd><a href={`https://www.wikidata.org/wiki/${c.wikidata}`}>{c.wikidata}</a></dd></div>}
        {c.derivedFrom && !c.derivedFrom.endsWith("/" + c.wikidata) && <div><dt>{T.source}</dt><dd><a href={c.derivedFrom}>{c.derivedFrom}</a></dd></div>}
        {c.broader.length > 0 && <div><dt>{T.broader}</dt><dd>{c.broader.map((b, k) => <>{k > 0 && ", "}<a href={cls(b.id)}>{b.name}</a></>)}</dd></div>}
        {c.narrower.length > 0 && <div><dt>{T.narrower}</dt><dd>{c.narrower.map((b, k) => <>{k > 0 && ", "}<a href={cls(b.id)}>{b.name}</a></>)}</dd></div>}
      </dl>

      {lines.length > 0 && (
        <section class="lines" aria-labelledby="h-lines">
          <h2 id="h-lines">{T.lines}</h2>
          {mapped.length > 0 && (
            <div class="map">
              <div id="line-map" role="img" aria-label={T.lines}></div>
              <p class="credit"><a href="https://www.openstreetmap.org/copyright">{T.mapCredit}</a></p>
            </div>
          )}
          <ul>
            {lines.map(l => (
              <li data-line={l.id} class:list={{ old: l.status !== "current" }}>
                {l.map ? <button type="button" data-line={l.id}><span class="sw" aria-hidden="true"></span>{l.label}</button>
                       : <span class="name"><span class="sw none" aria-hidden="true"></span>{l.label}</span>}
                <span class="meta">
                  {l.until && <span>{fmt(T.until, { y: l.until })}</span>}
                  {!l.map && mapped.length > 0 && <span>{T.noMap}</span>}
                  <a href={`https://www.wikidata.org/wiki/${l.id}`}>{l.id}</a>
                  {l.source && !l.source.includes("wikidata.org") && <a href={l.source}>{T.lineSource}</a>}
                </span>
              </li>
            ))}
          </ul>
          {mapped.length > 1 && <button type="button" class="all-lines">{T.linesAll}</button>}
          {mapped.length > 0 && <p class="hint">{T.linesHint}</p>}
        </section>
      )}
    </section>

    <aside class="media">
      <section class="card" aria-labelledby="h-export">
        <h2 id="h-export">{T.exportHeading}</h2>
        <h3>{T.citation}</h3>
        <div class="cite">
          <p id="cite-text">{cite}</p>
          <button type="button" id="cite-copy" data-done={T.copied} title={T.copy} aria-label={T.copy}>
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" d="M9 9h10v12H9zM5 15V3h10"/></svg>
          </button>
        </div>
        <h3>{T.export}</h3>
        <div class="exports">
          <a href={file(`rdf/class/${id}.ttl`)} download>Turtle</a>
          <a href={file(`rdf/class/${id}.jsonld`)} download>JSON-LD</a>
          {mods.map(m => hasManifest(m.id) && (
            <a class="iiif" href={file(`iiif/${m.id}/manifest.json`)}><img src={iiifLogo.src} alt="" width="20" height="18">{mods.length > 1 ? `${T.manifest} (${m.title})` : T.manifest}</a>
          ))}
          {mods.map(m => (
            <a href={file(`models/${m.id}.${M.ext}`)} download>{mods.length > 1 ? `${T.glb} (${m.title})` : T.glb}</a>
          ))}
        </div>
      </section>
      {c.photo && (
        <figure class="photo">
          <a href={c.photo.page}><img src={c.photo.src.startsWith("http") ? c.photo.src : file(c.photo.src)} alt={c.name} loading="lazy" decoding="async"></a>
          <figcaption>
            <a href={c.photo.page}>{c.photo.who ? fmt(T.photoBy, { who: c.photo.who }) : T.photoCommons}</a>
            {c.photo.lic && <> / {c.photo.licUrl ? <a href={c.photo.licUrl} rel="license">{c.photo.lic}</a> : c.photo.lic}</>}
          </figcaption>
        </figure>
      )}
    </aside>
  </div>

  <details class="ttl">
    <summary>{T.showTtl}</summary>
    <pre>{c.ttl}</pre>
  </details>
</div>
{mapped.length > 0 && <script type="application/json" id="lines-data" set:html={JSON.stringify(mapped.map(l => ({ id: l.id, label: l.label, old: l.status !== "current", src: file(`lines/${l.id}.geojson`) })))} />}
{mods.length > 0 && <script type="application/json" id="m3d-data" set:html={JSON.stringify({ models: mdata, orbit: ORBITS[0][1] })} />}
</Base>

<script>
  import { lineMap } from "../scripts/line-map";
  lineMap();

  // Copy the citation
  const cc = document.getElementById("cite-copy");
  cc?.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(document.getElementById("cite-text")!.textContent!);
      const t = cc.title; cc.title = cc.dataset.done!; cc.classList.add("done");
      setTimeout(() => { cc.title = t; cc.classList.remove("done"); }, 2000);
    } catch (e) {}
  });

  // Only on pages with a model: switch models, move the camera to a part (its IIIF camera: position and lookAt), orbits.
  const el = document.getElementById("m3d-data");
  if (el) {
    type Cam = { pos: number[]; look: number[] } | null;
    type M = { id: string; src: string; poster: string; tag: string; cams: Cam[]; marks: { at: number[]; n: number[] | null }[] };
    const D: { models: M[]; orbit: string } = JSON.parse(el.textContent!);
    const mv = document.getElementById("mv") as any;
    const all = (sel: string) => [...document.querySelectorAll<HTMLElement>(sel)];
    let cur = D.models[0];

    const orbitOf = (c: NonNullable<Cam>) => {
      const [dx, dy, dz] = c.pos.map((v, i) => v - c.look[i]);
      const r = Math.hypot(dx, dy, dz);
      return `${(Math.atan2(dx, dz) * 180 / Math.PI).toFixed(1)}deg ${(Math.acos(dy / r) * 180 / Math.PI).toFixed(1)}deg ${r.toFixed(1)}m`;
    };
    function overview(orbit = D.orbit) {
      mv.cameraTarget = "auto auto auto"; mv.cameraOrbit = orbit; mv.fieldOfView = "auto";
      for (const b of all("[data-part]")) b.removeAttribute("aria-current");
    }
    function focus(k: number) {
      const c = cur.cams[k];
      if (c) { mv.cameraTarget = c.look.map(v => `${v}m`).join(" "); mv.cameraOrbit = orbitOf(c); mv.fieldOfView = "30deg"; }
      for (const b of all("[data-part]")) b.toggleAttribute("aria-current", b.dataset.model === cur.id && +b.dataset.part! === k);
      document.querySelector<HTMLElement>(`.parts li button[data-model="${cur.id}"][data-part="${k}"]`)?.scrollIntoView({ block: "nearest", behavior: "smooth" });
      for (const o of all(".orbits [data-orbit]")) o.setAttribute("aria-pressed", "false");
    }
    function show(id: string) {
      cur = D.models.find(m => m.id === id) ?? D.models[0];
      if (mv.getAttribute("src") !== cur.src) { mv.src = cur.src; mv.poster = cur.poster; }
      document.getElementById("tag")!.textContent = cur.tag;
      for (const x of all("[data-model]:not(button)")) x.hidden = x.dataset.model !== cur.id;
      for (const h of all(".hs")) h.hidden = h.dataset.model !== cur.id;
      for (const b of all(".pick [data-model]")) b.setAttribute("aria-pressed", String(b.dataset.model === cur.id));
      overview();
    }
    for (const b of all(".pick [data-model]")) b.addEventListener("click", () => {
      show(b.dataset.model!);
      try { history.replaceState(null, "", "#" + cur.id); } catch (e) {}
    });
    for (const b of all("[data-part]")) b.addEventListener("click", () => focus(+b.dataset.part!));
    for (const b of all(".overview")) b.addEventListener("click", () => overview());
    const orbits = all(".orbits [data-orbit]");
    for (const b of orbits) b.addEventListener("click", () => {
      overview(b.dataset.orbit);
      for (const o of orbits) o.setAttribute("aria-pressed", String(o === b));
    });
    // Fade the markers on the far side: the camera position from its orbit around the target, then normal · (camera - point)
    function faces() {
      const o = mv.getCameraOrbit?.(), t = mv.getCameraTarget?.();
      if (!o || !t) return;
      const cam = [t.x + o.radius * Math.sin(o.phi) * Math.sin(o.theta), t.y + o.radius * Math.cos(o.phi), t.z + o.radius * Math.sin(o.phi) * Math.cos(o.theta)];
      for (const h of all(`.hs[data-model="${cur.id}"]`)) {
        const m = cur.marks[+h.dataset.part!];
        h.classList.toggle("back", !!m?.n && m.n.reduce((s, v, i) => s + v * (cam[i] - m.at[i]), 0) < 0);
      }
    }
    mv.addEventListener("camera-change", faces);
    mv.addEventListener("load", faces);
    const marks = document.getElementById("marks");
    marks?.addEventListener("click", () => {
      const on = marks.getAttribute("aria-pressed") !== "true";
      marks.setAttribute("aria-pressed", String(on));
      mv.classList.toggle("nomarks", !on);
    });
    const spin = document.getElementById("spin")!;
    spin.addEventListener("click", () => { const on = !mv.autoRotate; mv.autoRotate = on; spin.setAttribute("aria-pressed", String(on)); });
    if (location.hash && D.models.some(m => m.id === location.hash.slice(1))) show(location.hash.slice(1));
  }
</script>
