---
// One layout for every page: head, the theme decision (before first paint), shared header and footer.
import "../styles/site.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { LANGS, page, t, type Lang } from "../i18n";

interface Props {
  lang: Lang;
  path: string;          // this page without the language prefix: "" (top), "view.html"
  title?: string;        // full <title>; the site name alone when omitted
  description?: string;
  current?: string;      // nav key shown as the current page
  image?: { src: string; alt: string; size: [number, number] | null; type: string };  // share image under the site (class pages: the photo)
}
const { lang, path, title, description, current, image } = Astro.props;
const ui = t(lang);
const canonical = new URL(page(lang, path), Astro.site).href;
// Icon and share image are made by ~/git/tools/og-image from og-image.json into docs/site/ (copied by sync-public).
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const og = image
  ? { url: new URL(base + image.src, Astro.site).href, size: image.size, alt: image.alt, type: image.type }
  : { url: new URL(`${base}site/og-${lang}.jpg`, Astro.site).href, size: [1200, 630], alt: `${ui.site.name} — ${ui.site.description}`, type: "image/jpeg" };
---
<!doctype html>
<html lang={lang}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title ?? ui.site.name}</title>
<meta name="description" content={description ?? ui.site.description}>
<link rel="canonical" href={canonical}>
<meta property="og:title" content={title ?? ui.site.name}>
<meta property="og:description" content={description ?? ui.site.description}>
<meta property="og:site_name" content={ui.site.name}>
<meta property="og:type" content="website">
<meta property="og:url" content={canonical}>
<meta property="og:locale" content={lang === "en" ? "en_US" : "ja_JP"}>
<meta property="og:image" content={og.url}>
<meta property="og:image:type" content={og.type}>
{og.size && <meta property="og:image:width" content={String(og.size[0])}>}
{og.size && <meta property="og:image:height" content={String(og.size[1])}>}
<meta property="og:image:alt" content={og.alt}>
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href={`${base}site/favicon.ico`} sizes="32x32">
<link rel="icon" href={`${base}site/icon.svg`} type="image/svg+xml">
<link rel="apple-touch-icon" href={`${base}site/apple-touch-icon.png`}>
{LANGS.map(l => <link rel="alternate" hreflang={l} href={new URL(page(l, path), Astro.site).href}>)}
<link rel="alternate" hreflang="x-default" href={new URL(page("ja", path), Astro.site).href}>
<script is:inline>
// Light / dark chosen in the header is kept in localStorage; set it before the page paints so the colours never flash.
// No stored choice = follow the OS (site.css uses prefers-color-scheme).
(() => { try { const t = localStorage.getItem("theme"); if (t === "light" || t === "dark") document.documentElement.dataset.theme = t; } catch (e) {} })();
</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+New:wght@500;700&family=IBM+Plex+Mono:wght@400;500&display=swap">
<slot name="head" />
</head>
<body>
<SiteHeader lang={lang} path={path} current={current} />
<slot />
<SiteFooter lang={lang} />
</body>
</html>
