    wdt:P17 wd:Q419 ;
    wdt:P176 wd:Q2729224 ;
    wdt:P279 wd:Q752392 ;
    tb:handEntered wdt:P137,
        wdt:P17,
        wdt:P176,
        wdt:P279 ;
    tb:lineUse <https://w3id.org/railclass/tb-vistadome#line1> ;
