cls:tb-vistadome a skos:Concept,
        tb:VehicleClass ;
    rdfs:label "PeruRail Vistadome railcar (Macosa/MAN)"@en,
        "ペルーレイルのビスタドーム気動車（Macosa/MAN）"@ja ;
    dcterms:source "Country and operator from Wikidata Q100145062 (Tramo Sur Oriente del Ferrocarril del Sur, the line); builder (Macosa/MAN, 1984, cars 220-225; Macosa is today Stadler Rail Valencia, Q2729224) and type (single-cab diesel railcar) from en.wikipedia 'List of stock used by PeruRail' (read 2026-10-12) via the skytrain lab note docs/notes/vistadome.md."@en ;
    skos:inScheme cls: ;
    skos:prefLabel "PeruRail Vistadome railcar (Macosa/MAN)"@en,
        "ペルーレイルのビスタドーム気動車（Macosa/MAN）"@ja ;
