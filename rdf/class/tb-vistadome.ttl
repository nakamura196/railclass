<https://w3id.org/railclass/tb-vistadome#line1> a tb:LineUse ;
    dcterms:source <https://www.wikidata.org/wiki/Q100145062> ;
    skos:note "the Cusco - Machu Picchu line the Vistadome railcars run on; Wikidata has no item for the railcars"@en ;
    tb:line wd:Q100145062 ;
    tb:sourceSection "Wikidata (the line)" ;
    tb:useStatus "current" .

