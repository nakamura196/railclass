@prefix tb: <https://w3id.org/railclass/vocab#> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix wdt: <http://www.wikidata.org/prop/direct/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cls:tb-hktram a skos:Concept,
        tb:VehicleClass ;
    rdfs:label "Hong Kong Tramways double-deck tram (7th generation)"@en,
        "香港の路面電車（第 7 世代、2 階建て）"@ja ;
    dcterms:source "Country and operator from Wikidata Q385245 (Hong Kong Tramways, the system) and Q15902782 (the company); the 7th-generation body (2011-) from en.wikipedia 'Hong Kong Tramways' via the skytrain lab note docs/notes/hktram.md (2026-10-13)."@en ;
    skos:inScheme cls: ;
    skos:prefLabel "Hong Kong Tramways double-deck tram (7th generation)"@en,
        "香港の路面電車（第 7 世代、2 階建て）"@ja ;
    wdt:P137 wd:Q15902782 ;
    wdt:P17 wd:Q8646 ;
    wdt:P279 wd:Q3407658 ;
    wdt:P729 "2011"^^xsd:gYear ;
    tb:handEntered wdt:P137,
        wdt:P17,
        wdt:P279,
        wdt:P729 ;
    tb:lineUse <https://w3id.org/railclass/tb-hktram#line1> ;
    tb:usedOn wd:Q385245 .

<https://w3id.org/railclass/tb-hktram#line1> a tb:LineUse ;
    dcterms:source <https://www.wikidata.org/wiki/Q385245> ;
    skos:note "the Hong Kong Tramways system itself; Wikidata has no item for its 7th-generation cars"@en ;
    tb:line wd:Q385245 ;
    tb:sourceSection "Wikidata (the system)" ;
    tb:useStatus "current" .

wd:Q385245 rdfs:label "Hong Kong Tramways"@en .

