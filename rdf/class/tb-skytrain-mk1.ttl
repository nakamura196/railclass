@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tb: <https://w3id.org/railclass/vocab#> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix wdt: <http://www.wikidata.org/prop/direct/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cls:tb-skytrain-mk1 a skos:Concept,
        tb:VehicleClass ;
    rdfs:label "SkyTrain Mark I"@en,
        "スカイトレイン Mark I"@ja ;
    dcterms:source "Country and operator from Wikidata Q876780 (SkyTrain (Vancouver)); manufacturer from English Wikipedia 'SkyTrain (Vancouver)' (rolling stock section, read 2026-10-09); service entry year from the train-bodies gallery text."@en ;
    skos:broadMatch wd:Q4940487 ;
    skos:broader cls:Q4940487 ;
    skos:inScheme cls: ;
    skos:prefLabel "SkyTrain Mark I"@en,
        "スカイトレイン Mark I"@ja ;
    wdt:P137 wd:Q141170526 ;
    wdt:P17 wd:Q16 ;
    wdt:P176 wd:Q3552199 ;
    wdt:P729 "1985"^^xsd:gYear ;
    tb:handEntered wdt:P137,
        wdt:P17,
        wdt:P176,
        wdt:P729 .

